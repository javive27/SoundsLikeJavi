---
// src/pages/en/audiotools.astro
import Layout from '../layouts/Layout.astro';
import SoundEngineeringTools from '../components/SoundEngineeringTools.astro';
const base = import.meta.env.BASE_URL;
---

<Layout
    title="Audio Engineering Tools | Javier Flores"
    description="Professional sound engineering tools and technical resources by Javier Flores."
    lang="en"
    pathEs="audiotools"
    pathEn="audiotools"
>
    <div id="main" class="alt">
        <section id="one">
            <div class="inner">
                <header class="major">
                    <h1>Audio Engineering Tools</h1>
                </header>
                <SoundEngineeringTools />
            </div>
        </section>
    </div>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

        body, #wrapper {
            background-color: #0f131f !important;
            color: #e2e8f0;
            font-family: 'Inter', sans-serif !important;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Inter', sans-serif !important;
        }
    </style>
</Layout>
