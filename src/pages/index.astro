---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout
    title="Javier Flores Audio — Lead Audio Engineer & Live Sound"
    description="Lead Audio Engineer at Disney Cruise Line and Live Sound Engineer specializing in Dante AoIP networks, Q-SYS systems, and Music Production Engineering."
    lang="en"
    pathEs=""
    pathEn=""
>
    <!-- Banner -->
        <section id="banner" class="major">
            <!-- Background image optimized for the banner -->
            <div class="image-bg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; overflow: hidden;">
                <img src={`${base}images/Javier-Flores-banner.webp`} alt="Javier Flores Audio, Lead Audio Engineer performing live on stage at a festival" style="object-fit: cover; width: 100%; height: 100%; opacity: 0.35;" fetchpriority="high" />
            </div>

            <div class="inner">
                <header class="major">
                    <h1 class="hero-title">Hello! I'm Javier Flores, Lead Audio Engineer</h1>
                </header>
                <div class="content">
                    <p>I’m a Lead Audio Engineer and Disney Cruise Line audio technician with over 8 years of experience in live entertainment. Combining my background as a Music Production Engineer and live sound specialist in Dante AoIP and Q-SYS systems with an M.A. in Digital Media, I collaborate with multicultural crews to bring global shows to life. Let's create immersive audio narratives and unforgettable sonic experiences!<br /></p>
                    <ul class="actions">
                        <li><a href="#one" class="button next scrolly">More +</a></li>
                    </ul>
                </div>
            </div>
        </section>

    <!-- Main -->
        <div id="main">

            <!-- One -->
                <section id="one" class="tiles">
                    <article>
                        <span class="image">
                            <img src={`${base}images/Javier-Flores-Golden-Mickeys-bn.webp`} alt="Javier Flores, Music Production Engineer and sound designer receiving a Golden Mickeys award" loading="lazy" decoding="async" />
                        </span>
                        <header class="major">
                            <h2><a href={`${base}music`} class="link">Music & Sound Design</a></h2>
                            <p>My creations as a music producer</p>
                        </header>
                    </article>
                    <article>
                        <span class="image">
                            <img src={`${base}images/Javier-Flores-Dream-bn.webp`} alt="Javier Flores, Live Sound Engineer operating Q-SYS and Dante AoIP mixing consoles" loading="lazy" decoding="async" />
                        </span>
                        <header class="major">
                            <h2><a href={`${base}engineering`} class="link">Engineering & Live Sound</a></h2>
                            <p>My experience in engineering and audio</p>
                        </header>
                    </article>
                    <article>
                        <span class="image">
                            <img src={`${base}images/Javier-Flores-Taipei-Taiwan-bn.webp`} alt="Javier Flores, Disney Cruise Line audio technician on international tour" loading="lazy" decoding="async" />
                        </span>
                        <header class="major">
                            <h2><a href={`${base}experience`} class="link">Professional Experience</a></h2>
                            <p>Education, experiences and past work</p>
                        </header>
                    </article>
                    <article>
                        <span class="image">
                            <img src={`${base}images/Javier-Flores-Coctel-Calavera-sm.webp`} alt="Javier Flores performing live as saxophonist and live sound engineer" loading="lazy" decoding="async" />
                        </span>
                        <header class="major">
                            <h2><a href={`${base}saxophonist`} class="link">Saxophonist & Musician</a></h2>
                            <p>My achievements and life as a musician</p>
                        </header>
                    </article>
                    <article>
                        <span class="image">
                            <img src={`${base}images/Javier-Flores-Orquesta-ITESM.webp`} alt="Javier Flores Music Production Engineer testing musician tools" loading="lazy" decoding="async" />
                        </span>
                        <header class="major">
                            <h2><a href={`${base}music-tools`} class="link">Musician Tools</a></h2>
                            <p>Just in case you left your metronome and diapason at home</p>
                        </header>
                    </article>
                    <article>
                        <span class="image">
                            <img src={`${base}images/Javier-Flores-Frozen.webp`} alt="Javier Flores Lead Audio Engineer testing live sound engineering tools and equipment" loading="lazy" decoding="async" />
                        </span>
                        <header class="major">
                            <h2><a href={`${base}audiotools`} class="link">Audio Engineering Tools</a></h2>
                            <p>Audio Engineering Tools</p>
                        </header>
                    </article>
                </section>

        </div>

    <style>
        body, #wrapper {
            background-color: #0f131f !important;
        }
        .hero-title {
            font-size: clamp(2.5rem, 6vw, 5rem) !important;
            font-weight: 900 !important;
            color: #00e5ff !important;
            letter-spacing: -0.02em;
            line-height: 1.1;
        }
        /* Pattern: 1 blue, 2 purples, 2 blues, 2 purples... */
        #one.tiles article:nth-child(6n - 5):before { background-color: #6fc3df !important; } /* 1. Azul */
        #one.tiles article:nth-child(6n - 4):before { background-color: #8d82c4 !important; } /* 2. Púrpura 1 */
        #one.tiles article:nth-child(6n - 3):before { background-color: #8d82c4 !important; } /* 3. Púrpura 2 */
        #one.tiles article:nth-child(6n - 2):before { background-color: #6fc3df !important; } /* 4. Azul 1 */
        #one.tiles article:nth-child(6n - 1):before { background-color: #6fc3df !important; } /* 5. Azul 2 */
        #one.tiles article:nth-child(6n):before { background-color: #8d82c4 !important;     } /* 6. Púrpura 1 */
    </style>
</Layout>
