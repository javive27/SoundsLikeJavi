---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout
    title="Javier Flores Audio — Lead Audio Engineer & Live Sound"
    description="Lead Audio Engineer at Disney Cruise Line and Live Sound Engineer specializing in Dante AoIP networks, Q-SYS systems, and Music Production Engineering."
    lang="en"
    pathEs=""
    pathEn=""
>
    <!-- Banner -->
        <section id="banner" class="major">
            <!-- Background image optimized for the banner with responsive sizes and fetchpriority -->
            <div class="image-bg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; overflow: hidden;">
                <img src={`${base}images/Javier-Flores-banner.webp`} alt="Javier Flores Audio, Lead Audio Engineer performing live on stage at a festival" width="1335" height="1920" sizes="(max-width: 736px) 100vw, 1335px" style="object-fit: cover; width: 100%; height: 100%; opacity: 0.35;" fetchpriority="high" />
            </div>

            <div class="inner">
                <header class="major">
                    <h1 class="hero-title">Hello! I'm Javier Flores</h1>
                </header>
                <div class="content">
                    <p>I am a Live Audio Engineer and Lead Audio Tech for Disney Cruise Line, with over 8 years of experience in the entertainment industry. I hold a degree in Music Production Engineering and a Masters degree in Communication and Digital Media, with expertise in Dante AoIP networks, Q-SYS systems, and sound design and mixing for musical theatre. I am always looking to collaborate and create all kinds of immersive experiences.<br /></p>
                    <ul class="actions">
                        <li><a href="#one" class="button next scrolly">More +</a></li>
                    </ul>
                </div>
            </div>
        </section>

    <!-- Main -->
        <div id="main">

            <!-- One -->
                <section id="one" class="tiles">
                    <article>
                        <span class="image">
                            <img src={`${base}images/Javier-Flores-Golden-Mickeys-bn.webp`} alt="Javier Flores, Music Production Engineer and sound designer receiving a Golden Mickeys award" loading="lazy" decoding="async" width="800" height="600" />
                        </span>
                        <header class="major">
                            <h2><a href={`${base}music`} class="link" aria-label="Music and Sound Design">Music & Sound Design</a></h2>
                            <p>My creations as a music producer</p>
                        </header>
                    </article>
                    <article>
                        <span class="image">
                            <img src={`${base}images/Javier-Flores-Dream-bn.webp`} alt="Javier Flores, Live Sound Engineer operating Q-SYS and Dante AoIP mixing consoles" loading="lazy" decoding="async" width="800" height="600" />
                        </span>
                        <header class="major">
                            <h2><a href={`${base}engineering`} class="link" aria-label="Engineering and Live Sound">Engineering & Live Sound</a></h2>
                            <p>My experience in engineering and audio</p>
                        </header>
                    </article>
                    <article>
                        <span class="image">
                            <img src={`${base}images/Javier-Flores-Taipei-Taiwan-bn.webp`} alt="Javier Flores, Disney Cruise Line audio technician on international tour" loading="lazy" decoding="async" width="800" height="600" />
                        </span>
                        <header class="major">
                            <h2><a href={`${base}experience`} class="link" aria-label="Professional Experience">Professional Experience</a></h2>
                            <p>Education, experiences and past work</p>
                        </header>
                    </article>
                    <article>
                        <span class="image">
                            <img src={`${base}images/Javier-Flores-Coctel-Calavera-sm.webp`} alt="Javier Flores performing live as saxophonist and live sound engineer" loading="lazy" decoding="async" width="800" height="600" />
                        </span>
                        <header class="major">
                            <h2><a href={`${base}saxophonist`} class="link" aria-label="Saxophonist and Musician">Saxophonist & Musician</a></h2>
                            <p>My achievements and life as a musician</p>
                        </header>
                    </article>
                    <article>
                        <span class="image">
                            <img src={`${base}images/Javier-Flores-Orquesta-ITESM.webp`} alt="Javier Flores Music Production Engineer testing musician tools" loading="lazy" decoding="async" width="800" height="600" />
                        </span>
                        <header class="major">
                            <h2><a href={`${base}music-tools`} class="link" aria-label="Musician Tools">Musician Tools</a></h2>
                            <p>Just in case you left your metronome and diapason at home</p>
                        </header>
                    </article>
                    <article>
                        <span class="image">
                            <img src={`${base}images/Javier-Flores-Frozen.webp`} alt="Javier Flores Lead Audio Engineer testing live sound engineering tools and equipment" loading="lazy" decoding="async" width="800" height="600" />
                        </span>
                        <header class="major">
                            <h2><a href={`${base}audiotools`} class="link" aria-label="Audio Engineering Tools">Audio Engineering Tools</a></h2>
                            <p>Audio Engineering Tools</p>
                        </header>
                    </article>
                </section>

        </div>

    <style>
        body, #wrapper {
            background-color: #0f131f !important;
        }
        .hero-title {
            font-family: inherit;
        }
    </style>
</Layout>
