---
// src/pages/en/experience.astro
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout
	title="Experience — Javier Flores | Lead Audio Engineer (Q-SYS, Dante, Live Sound)"
	description="Javier Flores's résumé: Lead Audio Engineer at Disney Cruise Line. Expertise in Q-SYS, Dante AoIP networks, digital consoles, and live sound for global productions."
	lang="en"
	pathEs="experiencia"
	pathEn="experience"
>
	<!-- Main -->
		<div id="main" class="alt">
			<!-- One -->
				<section id="one">
					<div class="inner">
						<header class="major">
							<h1>Francisco Javier Flores Flores</h1><br>
							<h3>Lead Audio Engineer | M.A. Digital Communication & Media | Music Production Engineer</h3>
						</header>

						<!-- Content -->
							<h2 id="content">Profile</h2>
							<p>Creative Audio Engineer & Technical Lead with 8+ years of experience in live sound, system design, and broadcast operations for high-standard productions. Holding a Masters degree in Digital Communication & Media and a B.S. in Music Production Engineering, I bridge the gap between complex system architecture, technical precision, and creative storytelling across theaters and auditoriums.</p>
							
							<div class="row">
								<div class="col-6 col-12-small">
									<h3>Professional Experience</h3>
									<p>
										<strong>Disney Cruise Line (March 2022 - Present)</strong><br>
										<em>Lead Audio Engineer / Audio Technician Lead (June 2023 - Present)</em><br>
										<em>Audio Technician (December 2022 - June 2023) | General Technician Shipwide (March 2022)</em><br>
										• Lead technical operations for complex live and broadcast audio systems across shipwide venues, maintaining 100% uptime in high-stakes environments.<br>
										• Design and manage mission-critical Dante-based AoIP networks, integrating Q-SYS, AMX logic, DSPs, and zonal background music (BGM) control.<br>
										• Spearhead technical integration for rotating casts, dry-dock overhauls, show installations, and venue scheduling for rehearsals and soundchecks.<br>
										• FOH/MON mixing, IEMs, backline management, and cross-cultural team supervision ensuring 100% fidelity to Disney's sound design standards.<br><br>

										<strong>Universidad de las Américas Puebla - UDLAP (June 2019 - 2022)</strong><br>
										<em>Audio Visual & Sound Engineer</em><br>
										Managed AV infrastructure, mixing, lighting, and maintenance for a 600-seat auditorium, movie theater, conference halls, and outdoor venues.<br><br>

										<strong>Lunario del Auditorio Nacional (February 2020)</strong><br>
										<em>Monitors Audio Engineer</em><br>
										Monitors technician and audio engineer for the musical "All Shook Up".<br><br>

										<strong>AIRA Studio (May 2019 - July 2019)</strong><br>
										<em>Audio Electronics Development</em><br>
										Design and development of specialized audio electronics and hardware.<br><br>

										<strong>Compañía Folklórica Magisterial de Hidalgo (April 2018 - 2022)</strong><br>
										<em>Performer & Technical Coordinator</em><br>
										Technical coordination and musical performances on international tours: Yilan International Folklore Festival in Taiwan (2018) and Sharjah Heritage Days in UAE (2019).<br><br>

										<strong>La Casa de la Música de Viena en Puebla (January 2018 - July 2018)</strong><br>
										<em>Audio Technician & Museum Guide</em><br>
										FOH audio technician and venue operations within La Constancia Mexicana museum complex.<br><br>

										<strong>Econodiesel de Atlixco (2014 - December 2018)</strong><br>
										<em>Automotive Electrician</em><br>
										Electrical systems design, wiring, diagnostic troubleshooting, and maintenance.<br><br>

										<strong>Gran Ensamble Orchestra / Auditorio De La Reforma (June 2017 - December 2017)</strong><br>
										<em>FOH Audio Technician & Technical Staff</em><br>
										Stage setup, microphone placement, monitors mixing, and FOH operation.
									</p>
								</div>

								<div class="col-6 col-12-small">
									<h3>Education & Certifications</h3>
									<p>
										<strong>2025 | Universidad de las Américas Puebla (UDLAP)</strong><br>
										M.A. in Digital Communication & Media.<br><br>

										<strong>2019 | Tec de Monterrey (ITESM)</strong><br>
										B.S. in Music Production Engineering.<br><br>

										<strong>2019 | The College of Central Europe (Brno, Czech Republic)</strong><br>
										Specialty Certificate in Creative Economies Management.<br><br>

										<strong>2014 | CBTIS 16</strong><br>
										Technical Diploma in Electricity and Electronics.<br><br>

										<hr style="margin: 1.5rem 0;" />

										<strong>Courses & Certifications:</strong><br>
										• <strong>Xperience Makers:</strong> Diploma in Production Management with Broadway Professionals & Theaters (NY)<br>
										• <strong>Audinate:</strong> Dante Protocol (AoIP) Certified<br>
										• <strong>QSC / Q-SYS:</strong> Q-SYS Certified & Designer Training<br>
										• <strong>Shure:</strong> Integrated Systems & Wireless Microphones Certification<br>
										• <strong>Disney Learning:</strong> Leadership, Stunts, Pyrotechnics & Technical Operations Training<br>
										• <strong>Waves & Allen & Heath:</strong> SoundGrid Systems & SQ/CL5 Digital Consoles<br><br>

										<strong>Technical Systems & Skills:</strong><br>
										• <strong>Digital & Analog Mixers:</strong> API, Yamaha (CL5/PM), SSL, Allen & Heath, Avid, Behringer, Roland<br>
										• <strong>Systems & DSPs:</strong> Q-SYS, AMX, Timecode, AES, Dolby, QLab, RADAR, Clear-Com, Cinema Processors<br>
										• <strong>Software & Code:</strong> Pro Tools, QLab, Adobe CC, Python, Java, MS Office, macOS, Ubuntu
									</p>
								</div>
							</div>

						<hr class="major" />

						<!-- Key Competencies & Skills Extracted from CV -->
						<div class="row">
							<div class="col-4 col-12-medium">
								<h3>Areas of Expertise</h3>
								<ul>
									<li><strong>System Architecture:</strong> System design, integration, and logic programming.</li>
									<li><strong>Immersive & Sound Design:</strong> Holistic acoustic and visual design with a focus on creative integration.</li>
									<li><strong>DSPs & Signal Processing:</strong> Calibration, system tuning, amplifiers, digital/analog signal processing.</li>
									<li><strong>Stage Production & Rigging:</strong> Theatrical/stunts rigging, pyrotechnics, show control peripherals, and logistics.</li>
									<li><strong>Media & Transmedia Narratives:</strong> Digital and transmedia storytelling, consumer behavior, and strategic media.</li>
									<li><strong>Psychoacoustics & Acoustics:</strong> Room acoustics analysis, sound dynamics, and auditory impact.</li>
								</ul>
							</div>

							<div class="col-4 col-12-medium">
								<h3>Personal Skills</h3>
								<ul>
									<li>Strong artistic and creative sensibility with a deep understanding of sound dynamics.</li>
									<li>Project leadership with proven experience guiding, coaching, and managing technical teams.</li>
									<li>Highly adaptable and resilient in fast-paced, high-stakes, global production environments.</li>
									<li>Hands-on technical planning, integration, and cross-disciplinary troubleshooting.</li>
									<li>Collaborative mindset, excellent interpersonal abilities, and strong team player.</li>
									<li>Enthusiast of programming, artificial intelligence, and emerging technologies.</li>
								</ul>
							</div>

							<div class="col-4 col-12-medium">
								<h3>Key Features</h3>
								<ul>
									<li><strong>Nationality:</strong> Mexican</li>
									<li><strong>Languages:</strong> Spanish (Native) & English (C1 Fluent)</li>
									<li><strong>Alma Mater:</strong> ITESM, UDLAP</li>
									<li><strong>Industry Experience:</strong> 7+ years in AV/Audio engineering & 4+ years in international cruise lines</li>
									<li><strong>Core Systems:</strong> Q-SYS, Dante (AoIP), AMX, QLab, SSL, Yamaha, Avid, Shure</li>
								</ul>
							</div>
						</div>

						<hr class="major" />

						<!-- Buttons -->
							<h3>Download my CV</h3>
							<ul class="actions">
								<li><a href={`${base}docs/cvesp.pdf`} class="button icon fa-download">Spanish CV</a></li>
								<li><a href={`${base}docs/cving.pdf`} class="button icon fa-download">English CV</a></li>
							</ul>
					</div>
				</section>
		</div>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

        body, #wrapper {
            background-color: #0f131f !important;
            color: #e2e8f0;
            font-family: 'Inter', sans-serif !important;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Inter', sans-serif !important;
        }
    </style>
</Layout>
