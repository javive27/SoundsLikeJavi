---
// src/pages/en/experience.astro
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout
	title="Experience — Javier Flores | Lead Audio Engineer (Q-SYS, Dante, Live Sound)"
	description="Javier Flores's résumé: Lead Audio Engineer at Disney Cruise Line. Expertise in Q-SYS, Dante AoIP networks, digital consoles, and live sound for global productions."
	lang="en"
	pathEs="experiencia"
	pathEn="experience"
>
    <div class="experience-container">
        <!-- Hero Section -->
        <section class="experience-hero">
            <div class="hero-inner">
                <span class="hero-badge">Professional Background & Résumé</span>
                <h1 class="hero-title">Experience & Qualifications</h1>
                <p class="hero-subtitle">
                    Francisco Javier Flores Flores — Lead Audio Engineer, M.A. in Digital Communication & Media, and B.S. in Music Production Engineering.
                </p>
                <div class="divider-line"></div>
            </div>
        </section>

        <!-- Main Content -->
        <div id="main" class="main-content-wrapper">
            <section class="wrapper style1">
                <div class="inner">
                    
                    <!-- Profile Card -->
                    <div class="glass-card profile-card">
                        <h2>Profile</h2>
                        <p>
                            Creative Audio Engineer & Technical Lead with 8+ years of experience in live sound, system design, and broadcast operations for high-standard productions. Holding a Masters degree in Digital Communication & Media and a B.S. in Music Production Engineering, I bridge the gap between complex system architecture, technical precision, and creative storytelling across theaters and auditoriums.
                        </p>
                    </div>

                    <!-- Two Column Grid for Experience & Education -->
                    <div class="exp-grid">
                        <!-- Professional Experience -->
                        <div class="glass-card">
                            <h2>Professional Experience</h2>
                            
                            <div class="exp-item">
                                <h3>Disney Cruise Line</h3>
                                <span class="exp-date">March 2022 - Present</span>
                                <p class="exp-role"><em>Lead Audio Engineer / Audio Technician Lead (June 2023 - Present)</em><br>
                                <em>Audio Technician (December 2022 - June 2023) | General Technician Shipwide (March 2022)</em></p>
                                <ul>
                                    <li>Lead technical operations for complex live and broadcast audio systems across shipwide venues, maintaining 100% uptime in high-stakes environments.</li>
                                    <li>Design and manage mission-critical Dante-based AoIP networks, integrating Q-SYS, AMX logic, DSPs, and zonal background music (BGM) control.</li>
                                    <li>Spearhead technical integration for rotating casts, dry-dock overhauls, show installations, and venue scheduling for rehearsals and soundchecks.</li>
                                    <li>FOH/MON mixing, IEMs, backline management, and cross-cultural team supervision ensuring 100% fidelity to Disney's sound design standards.</li>
                                </ul>
                            </div>

                            <div class="exp-item">
                                <h3>Universidad de las Américas Puebla - UDLAP</h3>
                                <span class="exp-date">June 2019 - 2022</span>
                                <p class="exp-role"><em>Audio Visual & Sound Engineer</em></p>
                                <p>Managed AV infrastructure, mixing, lighting, and maintenance for a 600-seat auditorium, movie theater, conference halls, and outdoor venues.</p>
                            </div>

                            <div class="exp-item">
                                <h3>Lunario del Auditorio Nacional</h3>
                                <span class="exp-date">February 2020</span>
                                <p class="exp-role"><em>Monitors Audio Engineer</em></p>
                                <p>Monitors technician and audio engineer for the musical "All Shook Up".</p>
                            </div>

                            <div class="exp-item">
                                <h3>AIRA Studio</h3>
                                <span class="exp-date">May 2019 - July 2019</span>
                                <p class="exp-role"><em>Audio Electronics Development</em></p>
                                <p>Design and development of specialized audio electronics and hardware.</p>
                            </div>

                            <div class="exp-item">
                                <h3>Compañía Folklórica Magisterial de Hidalgo</h3>
                                <span class="exp-date">April 2018 - 2022</span>
                                <p class="exp-role"><em>Performer & Technical Coordinator</em></p>
                                <p>Technical coordination and musical performances on international tours: Yilan International Folklore Festival in Taiwan (2018) and Sharjah Heritage Days in UAE (2019).</p>
                            </div>

                            <div class="exp-item">
                                <h3>La Casa de la Música de Viena en Puebla</h3>
                                <span class="exp-date">January 2018 - July 2018</span>
                                <p class="exp-role"><em>Audio Technician & Museum Guide</em></p>
                                <p>FOH audio technician and venue operations within La Constancia Mexicana museum complex.</p>
                            </div>

                            <div class="exp-item">
                                <h3>Econodiesel de Atlixco</h3>
                                <span class="exp-date">2014 - December 2018</span>
                                <p class="exp-role"><em>Automotive Electrician</em></p>
                                <p>Electrical systems design, wiring, diagnostic troubleshooting, and maintenance.</p>
                            </div>

                            <div class="exp-item">
                                <h3>Gran Ensamble Orchestra / Auditorio De La Reforma</h3>
                                <span class="exp-date">June 2017 - December 2017</span>
                                <p class="exp-role"><em>FOH Audio Technician & Technical Staff</em></p>
                                <p>Stage setup, microphone placement, monitors mixing, and FOH operation.</p>
                            </div>
                        </div>

                        <!-- Education & Certifications -->
                        <div class="glass-card">
                            <h2>Education & Certifications</h2>
                            
                            <div class="exp-item">
                                <h3>Universidad de las Américas Puebla (UDLAP)</h3>
                                <span class="exp-date">2025</span>
                                <p>M.A. in Digital Communication & Media.</p>
                            </div>

                            <div class="exp-item">
                                <h3>Tec de Monterrey (ITESM)</h3>
                                <span class="exp-date">2019</span>
                                <p>B.S. in Music Production Engineering.</p>
                            </div>

                            <div class="exp-item">
                                <h3>The College of Central Europe (Brno, Czech Republic)</h3>
                                <span class="exp-date">2019</span>
                                <p>Specialty Certificate in Creative Economies Management.</p>
                            </div>

                            <div class="exp-item">
                                <h3>CBTIS 16</h3>
                                <span class="exp-date">2014</span>
                                <p>Technical Diploma in Electricity and Electronics.</p>
                            </div>

                            <div class="cert-block">
                                <h3>Courses & Certifications</h3>
                                <ul>
                                    <li><strong>Xperience Makers:</strong> Diploma in Production Management with Broadway Professionals & Theaters (NY)</li>
                                    <li><strong>Audinate:</strong> Dante Protocol (AoIP) Certified</li>
                                    <li><strong>QSC / Q-SYS:</strong> Q-SYS Certified & Designer Training</li>
                                    <li><strong>Shure:</strong> Integrated Systems & Wireless Microphones Certification</li>
                                    <li><strong>Disney Learning:</strong> Leadership, Stunts, Pyrotechnics & Technical Operations Training</li>
                                    <li><strong>Waves & Allen & Heath:</strong> SoundGrid Systems & SQ/CL5 Digital Consoles</li>
                                </ul>
                            </div>

                            <div class="cert-block">
                                <h3>Technical Systems & Skills</h3>
                                <ul>
                                    <li><strong>Digital & Analog Mixers:</strong> API, Yamaha (CL5/PM), SSL, Allen & Heath, Avid, Behringer, Roland</li>
                                    <li><strong>Systems & DSPs:</strong> Q-SYS, AMX, Timecode, AES, Dolby, QLab, RADAR, Clear-Com, Cinema Processors</li>
                                    <li><strong>Software & Code:</strong> Pro Tools, QLab, Adobe CC, Python, Java, MS Office, macOS, Ubuntu</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Three Column Grid for Competencies -->
                    <div class="competencies-grid">
                        <div class="glass-card">
                            <h3>Areas of Expertise</h3>
                            <ul>
                                <li><strong>System Architecture:</strong> System design, integration, and logic programming.</li>
                                <li><strong>Immersive & Sound Design:</strong> Holistic acoustic and visual design with a focus on creative integration.</li>
                                <li><strong>DSPs & Signal Processing:</strong> Calibration, system tuning, amplifiers, digital/analog signal processing.</li>
                                <li><strong>Stage Production & Rigging:</strong> Theatrical/stunts rigging, pyrotechnics, show control peripherals, and logistics.</li>
                                <li><strong>Media & Transmedia Narratives:</strong> Digital and transmedia storytelling, consumer behavior, and strategic media.</li>
                                <li><strong>Psychoacoustics & Acoustics:</strong> Room acoustics analysis, sound dynamics, and auditory impact.</li>
                            </ul>
                        </div>

                        <div class="glass-card">
                            <h3>Personal Skills</h3>
                            <ul>
                                <li>Strong artistic and creative sensibility with a deep understanding of sound dynamics.</li>
                                <li>Project leadership with proven experience guiding, coaching, and managing technical teams.</li>
                                <li>Highly adaptable and resilient in fast-paced, high-stakes, global production environments.</li>
                                <li>Hands-on technical planning, integration, and cross-disciplinary troubleshooting.</li>
                                <li>Collaborative mindset, excellent interpersonal abilities, and strong team player.</li>
                                <li>Enthusiast of programming, artificial intelligence, and emerging technologies.</li>
                            </ul>
                        </div>

                        <div class="glass-card">
                            <h3>Key Features</h3>
                            <ul>
                                <li><strong>Nationality:</strong> Mexican</li>
                                <li><strong>Languages:</strong> Spanish (Native) & English (C1 Fluent)</li>
                                <li><strong>Alma Mater:</strong> ITESM, UDLAP</li>
                                <li><strong>Industry Experience:</strong> 7+ years in AV/Audio engineering & 4+ years in international cruise lines</li>
                                <li><strong>Core Systems:</strong> Q-SYS, Dante (AoIP), AMX, QLab, SSL, Yamaha, Avid, Shure</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Download CV Section -->
                    <div class="glass-card cv-download-card">
                        <h2>Download My CV</h2>
                        <p>Get a comprehensive copy of my professional résumé in PDF format.</p>
                        <div class="actions-buttons">
                            <a href={`${base}docs/cvesp.pdf`} class="primary-btn">Spanish CV (PDF)</a>
                            <a href={`${base}docs/cving.pdf`} class="primary-btn secondary">English CV (PDF)</a>
                        </div>
                    </div>

                </div>
            </section>
        </div>
    </div>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

        body, #wrapper {
            background-color: #0f131f !important;
            color: #cbd5e1;
            font-family: 'Inter', sans-serif !important;
        }

        .experience-container {
            width: 100%;
            min-height: 100vh;
            background-color: #0f131f;
        }

        .experience-hero {
            padding: 8rem 2rem 4rem 2rem;
            text-align: center;
            background: linear-gradient(180deg, rgba(15, 19, 31, 0.95) 0%, rgba(21, 27, 43, 0.8) 100%);
            border-bottom: 1px solid rgba(0, 229, 255, 0.15);
        }

        .hero-inner {
            max-width: 1000px;
            margin: 0 auto;
        }

        .hero-badge {
            display: inline-block;
            background: rgba(0, 229, 255, 0.1);
            color: #00e5ff;
            padding: 0.5rem 1.25rem;
            border-radius: 20px;
            font-size: 0.875rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            margin-bottom: 1.5rem;
            border: 1px solid rgba(0, 229, 255, 0.3);
        }

        .hero-title {
            font-size: clamp(2.5rem, 5vw, 4rem);
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 1.5rem;
            letter-spacing: -0.02em;
            line-height: 1.1;
        }

        .hero-subtitle {
            font-size: 1.15rem;
            color: #94a3b8;
            max-width: 800px;
            margin: 0 auto 2rem auto;
            line-height: 1.6;
        }

        .divider-line {
            width: 80px;
            height: 3px;
            background: linear-gradient(90deg, #00e5ff, #8d82c4);
            margin: 0 auto;
            border-radius: 2px;
        }

        .main-content-wrapper {
            padding: 4rem 0;
        }

        .inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        .glass-card {
            background: rgba(21, 27, 43, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 2.5rem;
            margin-bottom: 2.5rem;
            backdrop-filter: blur(10px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            transition: transform 0.25s ease, border-color 0.25s ease;
        }

        .glass-card:hover {
            border-color: rgba(0, 229, 255, 0.3);
        }

        .glass-card h2 {
            color: #00e5ff;
            font-size: 1.8rem;
            margin-bottom: 1.5rem;
            font-weight: 700;
            border-bottom: 1px solid rgba(0, 229, 255, 0.2);
            padding-bottom: 0.5rem;
        }

        .glass-card h3 {
            color: #ffffff;
            font-size: 1.25rem;
            margin-top: 1.5rem;
            margin-bottom: 0.25rem;
            font-weight: 600;
        }

        .exp-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2.5rem;
            margin-bottom: 2.5rem;
        }

        .competencies-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-bottom: 2.5rem;
        }

        .exp-item {
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .exp-item:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .exp-date {
            display: inline-block;
            font-size: 0.85rem;
            font-weight: 600;
            color: #00e5ff;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
        }

        .exp-role {
            color: #94a3b8;
            font-size: 0.95rem;
            margin-bottom: 0.75rem;
        }

        .exp-item ul, .glass-card ul {
            padding-left: 1.25rem;
            color: #cbd5e1;
            line-height: 1.6;
        }

        .exp-item li, .glass-card li {
            margin-bottom: 0.5rem;
        }

        .cert-block {
            margin-top: 2rem;
        }

        .cv-download-card {
            text-align: center;
            background: linear-gradient(135deg, rgba(21, 27, 43, 0.9), rgba(15, 19, 31, 0.95));
            border: 1px solid rgba(0, 229, 255, 0.3);
        }

        .actions-buttons {
            display: flex;
            justify-content: center;
            gap: 1.5rem;
            margin-top: 2rem;
            flex-wrap: wrap;
        }

        .primary-btn {
            display: inline-block;
            background: linear-gradient(135deg, #00e5ff, #0088cc);
            color: #0f131f !important;
            padding: 0.85rem 2.5rem;
            border-radius: 12px;
            font-weight: 600;
            text-decoration: none;
            box-shadow: 0 4px 20px rgba(0, 229, 255, 0.3);
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        .primary-btn.secondary {
            background: transparent;
            color: #00e5ff !important;
            border: 2px solid #00e5ff;
        }

        .primary-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(0, 229, 255, 0.5);
        }

        @media (max-width: 1024px) {
            .exp-grid, .competencies-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .experience-hero {
                padding: 6rem 1rem 3rem 1rem;
            }
            .glass-card {
                padding: 1.5rem;
            }
        }
    </style>
</Layout>
