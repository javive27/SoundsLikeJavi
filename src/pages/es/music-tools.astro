---
import Layout from '../../layouts/Layout.astro';
// Asegúrate de que el nombre aquí coincida exacto con tu archivo en src/components/
import MusicToolsEnhanced from '../../components/MusicToolsEnhanced.astro'; 
const base = import.meta.env.BASE_URL;
---

<Layout
    title="Herramientas Musicales | Javier Flores"
    description="Colección de herramientas musicales interactivas desarrolladas por Javier Flores."
    lang="es"
    pathEs="music-tools"
    pathEn="music-tools"
>
    <div id="main" class="alt">
        <section id="one">
            <div class="inner">
                <header class="major">
                    <h1>Music Tools</h1>
                </header>
                <MusicToolsEnhanced />
            </div>
        </section>
    </div>
</Layout>