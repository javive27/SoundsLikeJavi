---
// src/pages/es/index.astro
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout
    title="Javier Flores Audio — Ingeniero de Audio en Vivo & Lead Audio Engineer"
    description="Ingeniero de Audio en Vivo y Lead Audio Engineer en Disney Cruise Line. Experto en redes Dante AoIP, sistemas Q-SYS, producción musical y diseño sonoro."
    lang="es"
    pathEs=""
    pathEn=""
>
    <!-- Banner -->
        <section id="banner" class="major">
            <!-- Background image optimized for the banner -->
            <div class="image-bg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; overflow: hidden;">
                <img src={`${base}images/Javier-Flores-banner.webp`} alt="Javier Flores Audio, Ingeniero de Audio en Vivo actuando en un escenario durante un festival" style="object-fit: cover; width: 100%; height: 100%; opacity: 0.35;" fetchpriority="high" />
            </div>

            <div class="inner">
                <header class="major">
                    <h1 class="hero-title">¡Hola! Soy Javier Flores, Ingeniero de Audio</h1>
                </header>
                <div class="content">
                    <p>Soy Ingeniero de Audio en Vivo y técnico de audio en Disney Cruise Line con más de 8 años de experiencia en entretenimiento global. Como Productor Musical y especialista en redes Dante AoIP y sistemas Q-SYS, disfruto diseñando experiencias sonoras inmersivas y colaborando en producciones internacionales. ¡Conectemos para llevar tus proyectos al siguiente nivel!<br /></p>
                    <ul class="actions">
                        <li><a href="#one" class="button next scrolly">Más +</a></li>
                    </ul>
                </div>
            </div>
        </section>

    <!-- Main -->
        <div id="main">

            <!-- One -->
                <section id="one" class="tiles">
                    <article>
                        <span class="image">
                            <img src={`${base}images/Javier-Flores-Golden-Mickeys-bn.webp`} alt="Javier Flores, Productor Musical y experto en diseño sonoro recibiendo un premio Golden Mickeys" loading="lazy" decoding="async" />
                        </span>
                        <header class="major">
                            <h2><a href={`${base}es/musica`} class="link">Música y Diseño Sonoro</a></h2>
                            <p>Mis creaciones como productor musical</p>
                        </header>
                    </article>
                    <article>
                        <span class="image">
                            <img src={`${base}images/Javier-Flores-Dream-bn.webp`} alt="Javier Flores, Ingeniero de Audio en Vivo operando sistemas Q-SYS y redes Dante AoIP" loading="lazy" decoding="async" />
                        </span>
                        <header class="major">
                            <h2><a href={`${base}es/ingenieria`} class="link">Ingeniería y Sonido En Vivo</a></h2>
                            <p>Mi experiencia en ingeniería y audio</p>
                        </header>
                    </article>
                    <article>
                        <span class="image">
                            <img src={`${base}images/Javier-Flores-Taipei-Taiwan-bn.webp`} alt="Javier Flores, técnico de audio Disney en giras internacionales" loading="lazy" decoding="async" />
                        </span>
                        <header class="major">
                            <h2><a href={`${base}es/experiencia`} class="link">Experiencia Profesional</a></h2>
                            <p>Educación, experiencias y trabajos anteriores</p>
                        </header>
                    </article>
                    <article>
                        <span class="image">
                            <img src={`${base}images/Javier-Flores-Coctel-Calavera-sm.webp`} alt="Javier Flores tocando el saxofón en un evento en vivo como músico profesional" loading="lazy" decoding="async" />
                        </span>
                        <header class="major">
                            <h2><a href={`${base}es/saxofonista`} class="link">Saxofonista y Músico</a></h2>
                            <p>Mis logros y trayectoria como músico</p>
                        </header>
                    </article>
                    <article>
                        <span class="image">
                            <img src={`${base}images/Javier-Flores-Orquesta-ITESM.webp`} alt="Javier Flores Productor Musical utilizando herramientas musicales" loading="lazy" decoding="async" />
                        </span>
                        <header class="major">
                            <h2><a href={`${base}es/musictools`} class="link">Herramientas Musicales</a></h2>
                            <p>Por si acaso olvidaste tu metrónomo y tu diapasón en casa</p>
                        </header>
                    </article>
                    <article>
                        <span class="image">
                            <img src={`${base}images/Javier-Flores-Frozen.webp`} alt="Javier Flores Lead Audio Engineer probando herramientas de ingeniería de sonido y audio" loading="lazy" decoding="async" />
                        </span>
                        <header class="major">
                            <h2><a href={`${base}es/audiotools`} class="link">Herramientas de Ingeniería de Audio</a></h2>
                            <p>Herramientas prácticas para ingeniería de sonido</p>
                        </header>
                    </article>
                </section>

        </div>

    <style>
        body, #wrapper {
            background-color: #0f131f !important;
        }
        .hero-title {
            font-size: clamp(2.5rem, 6vw, 5rem) !important;
            font-weight: 900 !important;
            color: #00e5ff !important;
            letter-spacing: -0.02em;
            line-height: 1.1;
        }
        /* Pattern: 1 blue, 2 purples, 2 blues, 2 purples... */
        #one.tiles article:nth-child(6n - 5):before { background-color: #6fc3df !important; } /* 1. Azul */
        #one.tiles article:nth-child(6n - 4):before { background-color: #8d82c4 !important; } /* 2. Púrpura 1 */
        #one.tiles article:nth-child(6n - 3):before { background-color: #8d82c4 !important; } /* 3. Púrpura 2 */
        #one.tiles article:nth-child(6n - 2):before { background-color: #6fc3df !important; } /* 4. Azul 1 */
        #one.tiles article:nth-child(6n - 1):before { background-color: #6fc3df !important; } /* 5. Azul 2 */
        #one.tiles article:nth-child(6n):before { background-color: #8d82c4 !important;     } /* 6. Púrpura 1 */
    </style>
</Layout>
