---
// src/pages/es/musica.astro
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout
    title="Música y Diseño Sonoro | Javier Flores — Productor Musical y Compositor"
    description="Música y diseño sonoro por Javier Flores: composición, producción musical y bandas sonoras. Escucha Jardín en tu mirada, One Please y Death and the Maiden."
    lang="es"
    pathEs="musica"
    pathEn="music"
>
    <!-- Contenedor principal simplificado -->
    <div class="music-container">
        
        <!-- Hero Section Homologado -->
        <section class="music-hero">
            <div class="hero-inner">
                <span class="hero-badge">Creación Audiovisual</span>
                <h1 class="hero-title">Producción Musical y Diseño Sonoro</h1>
                <p class="hero-subtitle">Explorando la narrativa a través del sonido, la orquestación original y la atmósfera sonora para cine, teatro y festivales de la canción.</p>
                <div class="divider-line"></div>
            </div>
        </section>

        <!-- Main Content Sections -->
        <div id="main" class="main-content-wrapper">
            <!-- Project 1: Jardin en tu mirada -->
            <section class="music-section">
                <div class="inner">
                    <div class="music-grid">
                        <div class="music-media-wrapper">
                            <div class="media-card">
                                <div class="video-container">
                                    <iframe src="https://player.vimeo.com/video/334967419" width="100%" height="360" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
                                </div>
                                <div class="media-caption">Jardín en tu mirada — Interpretación en vivo y producción</div>
                            </div>
                        </div>
                        <div class="music-text-content">
                            <span class="section-tag">01 / Festival de la Canción y Composición</span>
                            <h2>Jardín en tu mirada</h2>
                            <p class="composers-tag"><strong>Compositores:</strong> Victor Valle y Francisco Flores</p>
                            <p>Esta canción ganó el premio a <strong>Mejor Letra</strong> en el Festival de la Canción del ITESM Campus Puebla y fue nominada a <strong>Mejor Arreglo Musical</strong> en la ceremonia de premiación de producciones audiovisuales de la misma universidad.</p>
                            <p>Combinando estructuras armónicas contemporáneas con lirismo poético, la pieza destaca por un arreglo vocal meticuloso e instrumentación atmosférica.</p>
                            <div class="tech-specs">
                                <span class="spec-badge">Ganador Festival de la Canción</span>
                                <span class="spec-badge">Premio Mejor Letra</span>
                                <span class="spec-badge">Nominado a Mejor Arreglo</span>
                                <span class="spec-badge">ITESM Puebla</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Project 2: One Please -->
            <section class="music-section alt-bg">
                <div class="inner">
                    <div class="music-grid reverse">
                        <div class="music-text-content">
                            <span class="section-tag">02 / Banda Sonora Original</span>
                            <h2>One Please</h2>
                            <p>Una composición original creada para el cortometraje de terror psicológico <strong>"One Please"</strong>. El objetivo principal de la música es amplificar la tensión emocional y el suspenso, alejándose del silencio sordo de la producción original.</p>
                            <p>Además de la partitura musical, diseñé efectos de sonido y foley personalizados para acentuar la atmósfera cinematográfica.</p>
                            <div class="tech-specs">
                                <span class="spec-badge">Banda Sonora Original</span>
                                <span class="spec-badge">Diseño Sonoro</span>
                                <span class="spec-badge">Cortometraje de Terror</span>
                                <span class="spec-badge">Foley y Efectos</span>
                            </div>
                            <div class="actions-wrapper">
                                <a href="https://www.youtube.com/watch?v=YS8UgWEpXAM&" target="_blank" rel="noopener noreferrer" class="button primary-btn">Ver Cortometraje Original</a>
                            </div>
                        </div>
                        <div class="music-media-wrapper">
                            <div class="media-card">
                                <div class="video-container">
                                    <iframe src="https://player.vimeo.com/video/334967471" width="100%" height="360" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
                                </div>
                                <div class="media-caption">One Please — Música original para cortometraje</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Project 3: Death and the Maiden -->
            <section class="music-section">
                <div class="inner">
                    <div class="music-grid">
                        <div class="music-media-wrapper">
                            <div class="media-card">
                                <div class="video-container tall-video">
                                    <iframe src="https://player.vimeo.com/video/334967398" width="100%" height="520" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
                                </div>
                                <div class="media-caption">Death and the Maiden — Presentación de partitura orquestal</div>
                            </div>
                        </div>
                        <div class="music-text-content">
                            <span class="section-tag">03 / Composición Orquestal</span>
                            <h2>Death And The Maiden</h2>
                            <p class="excerpt-intro">Música creada con el fin de traducir el siguiente extracto literario en sonido:</p>
                            <blockquote class="literary-excerpt">
                                "Franz-Josef — Emperador de Austria — despertó de una pesadilla. Había tomado la forma de una visión infernal: multitudes en la calle, disparos y armas incendiarias improvisadas derramando fuego sobre los adoquines fuera del palacio. El mariscal de campo Radetzky, en realidad muerto desde hacía más de medio siglo, había irrumpido en el ala de la cancillería. Todo está perdido, había gritado... al emperador no le había preocupado cuestionar por qué una gran orquesta tocaba un vals de Strauss mientras Viena ardía."
                                <cite>— Frank Tallis, "Death and the Maiden"</cite>
                            </blockquote>
                            <p>La composición se apoya en recursos compositivos avanzados como <strong>leitmotifs</strong> e <strong>idée fixes</strong>, cambios de regiones armónicas, secuencias de modulación cromática y escalas simétricas para reflejar la disolución caótica del sueño austrohúngaro.</p>
                            <div class="tech-specs">
                                <span class="spec-badge">Partitura Orquestal</span>
                                <span class="spec-badge">Arquitectura de Leitmotifs</span>
                                <span class="spec-badge">Escalas Simétricas</span>
                                <span class="spec-badge">Adaptación Frank Tallis</span>
                            </div>
                            <div class="actions-wrapper">
                                <a href={`${base}docs/DATM.pdf`} target="_blank" rel="noopener noreferrer" class="button primary-btn icon fa-download">Ver Partitura Completa (PDF)</a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

        body, #wrapper {
            background-color: #0f131f !important;
            color: #e2e8f0;
            font-family: 'Inter', sans-serif !important;
        }

        /* --- AJUSTES DEL HERO Y LAYOUT SUPERIOR --- */
        .music-container {
            padding-bottom: 6rem;
        }

        .music-hero {
            padding: 7rem 0 4rem 0;
            text-align: left;
        }

        .hero-inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        .hero-badge {
            display: inline-block;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: #00e5ff;
            margin-bottom: 1rem;
        }

        .hero-title {
            font-size: clamp(2.5rem, 5vw, 4rem);
            font-weight: 700;
            color: #ffffff;
            line-height: 1.1;
            margin: 0 0 1.25rem 0;
        }

        .hero-subtitle {
            font-size: 1.2rem;
            color: #94a3b8;
            line-height: 1.6;
            margin: 0 0 2.5rem 0;
            max-width: 1000px;
        }

        .divider-line {
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, #00e5ff, #6fc3df);
            border-radius: 2px;
            margin-top: 2rem;
        }

        /* --- RESTO DEL CONTENIDO --- */
        .music-section .inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        .music-section {
            padding: 5rem 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .music-section.alt-bg {
            background-color: rgba(21, 27, 43, 0.5);
        }

        .music-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
        }

        .music-grid.reverse {
            grid-template-columns: 1fr 1fr;
        }

        .music-grid.reverse .music-text-content {
            order: 1;
        }

        .music-grid.reverse .music-media-wrapper {
            order: 2;
        }

        .section-tag {
            display: inline-block;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #00e5ff;
            margin-bottom: 0.75rem;
        }

        .music-text-content h2 {
            font-size: 2.25rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 1rem;
            line-height: 1.2;
        }

        .music-text-content p {
            font-size: 1.05rem;
            color: #cbd5e1;
            line-height: 1.7;
            margin-bottom: 1.25rem;
        }

        .composers-tag {
            color: #94a3b8;
            font-size: 0.95rem;
            margin-bottom: 1rem !important;
        }

        .excerpt-intro {
            font-style: italic;
            color: #94a3b8;
            margin-bottom: 0.75rem !important;
        }

        .literary-excerpt {
            background: rgba(15, 19, 31, 0.7);
            border-left: 3px solid #00e5ff;
            padding: 1.25rem;
            margin: 1rem 0 1.5rem 0;
            font-size: 0.95rem;
            color: #cbd5e1;
            line-height: 1.6;
            border-radius: 0 8px 8px 0;
        }

        .literary-excerpt cite {
            display: block;
            margin-top: 0.5rem;
            font-size: 0.85rem;
            color: #00e5ff;
            font-style: normal;
            font-weight: 600;
        }

        .tech-specs {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin: 1.75rem 0;
        }

        .spec-badge {
            background-color: rgba(0, 229, 255, 0.1);
            color: #00e5ff;
            padding: 0.35rem 0.85rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 500;
            border: 1px solid rgba(0, 229, 255, 0.2);
        }

        .media-card {
            background: #151b2b;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.2);
            transition: transform 0.3s ease, border-color 0.3s ease;
        }

        .media-card:hover {
            transform: translateY(-4px);
            border-color: rgba(0, 229, 255, 0.4);
        }

        .video-container {
            position: relative;
            width: 100%;
            height: 340px;
            background: #000;
        }

        .video-container.tall-video {
            height: 440px;
        }

        .video-container iframe {
            width: 100%;
            height: 100%;
            border: 0;
        }

        .media-caption {
            padding: 1rem 1.25rem;
            font-size: 0.85rem;
            color: #94a3b8;
            background: #111726;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            font-weight: 500;
        }

        .actions-wrapper {
            margin-top: 2rem;
        }

        .primary-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: linear-gradient(135deg, #00e5ff, #0088cc) !important;
            color: #0f131f !important;
            padding: 0.75rem 1.75rem;
            border-radius: 12px;
            font-weight: 600;
            text-decoration: none;
            transition: opacity 0.25s ease, transform 0.25s ease;
            box-shadow: 0 4px 14px rgba(0, 229, 255, 0.3);
        }

        .primary-btn:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }

        @media screen and (max-width: 960px) {
            .music-grid, .music-grid.reverse {
                grid-template-columns: 1fr;
                gap: 2.5rem;
            }
            .music-grid.reverse .music-text-content,
            .music-grid.reverse .music-media-wrapper {
                order: unset;
            }
        }
    </style>
</Layout>
