---
// src/pages/es/ingenieria.astro
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout
    title="Ingeniería de Audio | Javier Flores — Live Sound, Q-SYS y Sistemas AoIP"
    description="Ingeniería de audio de Javier Flores: audio en vivo, sistemas Q-SYS, redes Dante AoIP, grabación y mezcla para producciones globales en teatros y cruceros."
    lang="es"
    pathEs="ingenieria"
    pathEn="engineering"
>
    <div class="engineering-container">
        <!-- Header Section -->
        <section class="engineering-hero">
            <div class="inner">
                <header class="major">
                    <h1 class="hero-title">Ingeniería y Audio</h1>
                </header>
                <p class="hero-subtitle">Mi experiencia en sistemas de audio incluye diseño Q-SYS, consolas de audio digitales y análogas, sistemas de comunicación, arreglos lineales (line arrays) y sistemas de PA, entre otros.</p>
                <div class="divider-line"></div>
            </div>
        </section>

        <!-- Main Content Sections -->
        <div id="main" class="main-content-wrapper">
            <!-- Section 1: Disney Cruise Line (At the top) -->
            <section class="eng-section">
                <div class="inner">
                    <div class="eng-grid">
                        <div class="eng-text-content">
                            <span class="section-tag">01 / Sistemas de Audio en Cruceros</span>
                            <h2>Disney Cruise Line</h2>
                            <p>Como Técnico Principal de Audio para Disney Cruise Line, administro sistemas de audio complejos a bordo de embarcaciones de clase mundial. Operando principalmente en el emblemático <strong>Walt Disney Theater</strong>, mis responsabilidades abarcan infraestructuras de audio de vanguardia basadas en redes de procesamiento y enrutamiento <strong>Q-SYS</strong>, consolas de mezcla digital <strong>Yamaha Rivage</strong> y robustas matrices de comunicación <strong>Clear-Com</strong>.</p>
                            <p>Trabajar en entornos teatrales de alta presión exige control impecable, resolución rápida de problemas y fidelidad de audio impecable para miles de huéspedes diariamente en producciones con estándares de Broadway.</p>
                            <div class="tech-specs">
                                <span class="spec-badge">Ecosistemas Q-SYS</span>
                                <span class="spec-badge">Consolas Yamaha Rivage</span>
                                <span class="spec-badge">Intercomunicación Clear-Com</span>
                                <span class="spec-badge">Sistemas Shure</span>
                            </div>
                        </div>
                        <div class="eng-image-wrapper">
                            <div class="image-card">
                                <img src={`${base}images/Javier-Flores-Frozen.webp`} alt="Javier Flores Lead Audio Engineer probando herramientas de ingeniería de sonido y audio en Disney Cruise Line" loading="lazy" decoding="async" width="800" height="600" />
                                <div class="image-caption">Lead Audio Tech y Operación de Sistemas — Walt Disney Theater</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Section 2: Musical Theater & Broadway Training -->
            <section class="eng-section alt-bg">
                <div class="inner">
                    <div class="eng-grid reverse">
                        <div class="eng-text-content">
                            <span class="section-tag">02 / Producciones Teatrales</span>
                            <h2>Teatro Musical y Formación en Broadway</h2>
                            <p>Mi carrera en ingeniería de sonido teatral abarca importantes producciones como <strong>Beauty and the Beast</strong>, <strong>Golden Mickeys</strong>, <strong>Frozen</strong>, <strong>Tangled</strong> y <strong>Twice Charmed</strong>, entre otras. Cada espectáculo requiere una gestión precisa de micrófonos inalámbricos, programación compleja de cues y mezcla de audio impecable.</p>
                            <p>Ampliando mi especialización, tuve el privilegio de estudiar sonido y producción de teatro musical en Broadway (Nueva York), analizando obras emblemáticas como <strong>Moulin Rouge</strong> y <strong>Wicked</strong>, y tomando clases magistrales directamente con stage managers, diseñadores de iluminación, diseñadores de sonido y profesionales de teatro en activo de Broadway.</p>
                            <p>A nivel nacional en México, tuve la increíble oportunidad de trabajar en el prestigioso <strong>Lunario del Auditorio Nacional</strong> en la Ciudad de México, musicalizando la producción <strong>"All Shook Up"</strong> en colaboración con la UDLAP.</p>
                            <div class="tech-specs">
                                <span class="spec-badge">Capacitación en Broadway (NYC)</span>
                                <span class="spec-badge">Auditorio Nacional</span>
                                <span class="spec-badge">Walt Disney Theater</span>
                            </div>
                        </div>
                        <div class="eng-image-wrapper">
                            <div class="image-card">
                                <img src={`${base}images/Javier-Flores-Broadway.webp`} alt="Javier Flores durante su formación en teatro musical y producciones de Broadway" loading="lazy" decoding="async" width="800" height="600" />
                                <div class="image-caption">Formación en Broadway y Experiencia en Teatro Musical</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Section 3: Live Audio -->
            <section class="eng-section">
                <div class="inner">
                    <div class="eng-grid">
                        <div class="eng-text-content">
                            <span class="section-tag">03 / Experiencia de Campo</span>
                            <h2>Audio en Vivo y Giras</h2>
                            <p>He desempeñado roles clave en ingeniería de audio en vivo. Al inicio de mi carrera, trabajé en La Constancia Mexicana en Puebla, específicamente en el museo <strong>La Casa de la Música de Viena en Puebla</strong>. Mis responsabilidades incluyeron mantenimiento de sistemas del museo, recorridos técnicos guiados y laborar como el ingeniero de audio principal en su auditorio con capacidad para 500 personas.</p>
                            <p>También colaboro como músico y técnico de sonido con la Compañía Folklórica Magisterial de Hidalgo. Durante giras y festivales internacionales, como los <strong>Sharjah Heritage Days (UAE)</strong> y el <strong>Yilan International Children's Folklore and Folkgame Festival en Taiwán</strong>, actué como enlace técnico entre directores de la compañía, músicos y cuadrillas locales de ingeniería de audio.</p>
                            <p>Adicionalmente, al trabajar con la Universidad de las Américas Puebla <strong>(UDLAP)</strong> en relaciones públicas, mezclé audio para producciones en vivo en diversos recintos, incluido el <strong>Auditorio Nacional</strong> en la Ciudad de México y la Catedral de Puebla.</p>
                        </div>
                        <div class="eng-image-wrapper">
                            <div class="image-card">
                                <img src={`${base}images/Javier-Flores-Casa-de-la-Musica-de-Viena.webp`} alt="Javier Flores como técnico de audio FOH en el auditorio de La Casa de la Música de Viena en Puebla" loading="lazy" decoding="async" width="800" height="600" />
                                <div class="image-caption">Ingeniero de Audio FOH — La Casa de la Música de Viena, Puebla</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Section 4: Recording and Mixing -->
            <section class="eng-section alt-bg">
                <div class="inner">
                    <div class="eng-grid reverse">
                        <div class="eng-text-content">
                            <span class="section-tag">04 / Oficio de Estudio</span>
                            <h2>Grabación y Mezcla</h2>
                            <p>Estudiar Ingeniería en Producción Musical me proveyó de técnicas avanzadas de microfoneo, flujos de trabajo de mezcla análoga y digital, y análisis acústico crítico.</p>
                            <p>Aunque mi enfoque principal es la ingeniería de sonido en vivo, he colaborado en diversos proyectos de grabación y mezcla en estudio, incluido el álbum debut de la banda de metal Disgrace In Heaven.</p>
                            <div class="tech-specs">
                                <span class="spec-badge">Sistemas Análogos y Digitales</span>
                                <span class="spec-badge">Flujos de Señal</span>
                                <span class="spec-badge">Técnicas Avanzadas de Microfoneo</span>
                                <span class="spec-badge">Acústica</span>
                            </div>
                        </div>
                        <div class="eng-image-wrapper">
                            <div class="image-card">
                                <img src={`${base}images/Javier-Flores-estudio-Tec-Puebla.webp`} alt="Javier Flores en el estudio de grabación del Tec de Monterrey Campus Puebla durante una sesión de mezcla" loading="lazy" decoding="async" width="800" height="600" />
                                <div class="image-caption">Sesión de Grabación y Mezcla — Estudio Tec de Monterrey Puebla</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

        body, #wrapper {
            background-color: #0f131f !important;
            color: #e2e8f0;
            font-family: 'Inter', sans-serif !important;
        }

        .engineering-container {
            padding-top: 6rem;
            padding-bottom: 6rem;
        }

        .engineering-hero {
            padding: 4rem 0 2rem 0;
            text-align: left;
        }

        .engineering-hero .inner, .eng-section .inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
            box-sizing: border-box;
            width: 100%;
        }

        .hero-badge-container {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-bottom: 1.5rem;
        }

        .hero-pill {
            background: rgba(15, 19, 31, 0.75);
            border: 1px solid rgba(0, 229, 255, 0.3);
            color: #00e5ff;
            padding: 0.4rem 1rem;
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0, 229, 255, 0.1);
        }

        .accent-pill {
            border-color: rgba(111, 195, 223, 0.3);
            color: #6fc3df;
        }

        .hero-title {
            font-size: clamp(2.5rem, 4vw, 4rem) !important;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.02em;
            margin-bottom: 1rem !important;
        }

        .hero-subtitle {
            font-size: 1.15rem;
            color: #cbd5e1;
            max-width: 750px;
            line-height: 1.6;
            margin-bottom: 2rem;
        }

        .divider-line {
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, #00e5ff, #8d82c4);
            border-radius: 2px;
        }

        .main-content-wrapper {
            margin-top: 3rem;
        }

        .eng-section {
            padding: 4rem 0;
        }

        .eng-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
        }

        .eng-grid.reverse {
            direction: rtl;
        }

        .eng-grid.reverse > * {
            direction: ltr;
        }

        .section-tag {
            display: inline-block;
            color: #00e5ff;
            text-transform: uppercase;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.2em;
            margin-bottom: 0.75rem;
        }

        .eng-text-content h2 {
            font-size: clamp(1.8rem, 2.5vw, 2.5rem) !important;
            color: #ffffff !important;
            font-weight: 700 !important;
            margin-bottom: 1.5rem !important;
            letter-spacing: -0.02em !important;
        }

        .eng-text-content p {
            font-size: 1.05rem;
            line-height: 1.8;
            color: #cbd5e1;
            margin-bottom: 1.5rem;
        }

        .tech-specs {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-top: 2rem;
        }

        .spec-badge {
            background: rgba(111, 195, 223, 0.08);
            border: 1px solid rgba(111, 195, 223, 0.25);
            color: #6fc3df;
            padding: 0.4rem 0.9rem;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .image-card {
            background: rgba(15, 19, 31, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 15px 35px rgba(0,0,0,0.4);
            transition: transform 0.3s ease, border-color 0.3s ease;
        }

        .image-card:hover {
            transform: translateY(-5px);
            border-color: rgba(0, 229, 255, 0.4);
        }

        .image-card img {
            width: 100%;
            height: auto;
            display: block;
            object-fit: cover;
        }

        .image-caption {
            padding: 1rem 1.25rem;
            font-size: 0.85rem;
            color: #94a3b8;
            background: rgba(15, 19, 31, 0.9);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            font-weight: 500;
        }

        @media screen and (max-width: 900px) {
            .eng-grid, .eng-grid.reverse {
                grid-template-columns: 1fr;
                gap: 2.5rem;
                direction: ltr;
            }
            .engineering-container {
                padding-top: 4rem;
            }
        }

        @media screen and (max-width: 736px) {
            .engineering-hero .inner, .eng-section .inner {
                padding: 0 1.5rem;
            }
        }
    </style>
</Layout>
