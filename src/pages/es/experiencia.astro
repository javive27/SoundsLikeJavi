---
// src/pages/es/experiencia.astro
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout
	title="Experiencia — Javier Flores | Lead Audio Engineer (Q-SYS, Dante, Live Sound)"
	description="Currículum de Javier Flores: Lead Audio Engineer en Disney Cruise Line. Experto en redes Dante AoIP, sistemas Q-SYS, consolas digitales y audio en vivo."
	lang="es"
	pathEs="experiencia"
	pathEn="experience"
>
    <div class="experience-container">
        <!-- Hero Section -->
        <section class="experience-hero">
            <div class="hero-inner">
                <span class="hero-badge">Trayectoria Profesional y Currículum</span>
                <h1 class="hero-title">Experiencia y Cualificaciones</h1>
                <p class="hero-subtitle">
                    Francisco Javier Flores Flores — Ingeniero de Audio Principal, M.A. en Comunicación y Medios Digitales e Ing. en Producción Musical.
                </p>
                <div class="divider-line"></div>
            </div>
        </section>

        <!-- Main Content -->
        <div id="main" class="main-content-wrapper">
            <section class="wrapper style1">
                <div class="inner">
                    
                    <!-- Profile Card -->
                    <div class="glass-card profile-card">
                        <h2>Perfil Profesional</h2>
                        <p>
                            Ingeniero de audio creativo, líder técnico y gerente de producción con más de 7 años de experiencia ejecutando sonido en vivo de alto impacto, diseño de sistemas y operaciones de transmisión para producciones globales con margen de error cero. Con una Maestría en Comunicación y Medios Digitales y un título en Ingeniería de Producción Musical, conecto la arquitectura de sistemas complejos y la precisión técnica con la narrativa escénica en teatros, cruceros, auditorios y giras internacionales.
                        </p>
                    </div>

                    <!-- Two Column Grid for Experience & Education -->
                    <div class="exp-grid">
                        <!-- Professional Experience -->
                        <div class="glass-card">
                            <h2>Experiencia Profesional</h2>
                            
                            <div class="exp-item">
                                <h3>Disney Cruise Line</h3>
                                <span class="exp-date">Marzo 2022 - Presente</span>
                                <p class="exp-role"><em>Lead Audio Engineer / Audio Technician Lead (Junio 2023 - Presente)</em><br>
                                <em>Audio Technician (Diciembre 2022 - Junio 2023) | General Technician Shipwide (Marzo 2022)</em></p>
                                <ul>
                                    <li>Lidero las operaciones técnicas de sistemas de audio complejos para espectáculos en vivo y transmisiones en todos los recintos a bordo, manteniendo un tiempo de actividad del 100% en entornos de alta exigencia.</li>
                                    <li>Diseño y administro redes AoIP basadas en Dante de misión crítica, integrando Q-SYS, lógica AMX, DSPs y control zonal de música ambiental (BGM).</li>
                                    <li>Encabezo la integración técnica para elencos rotativos, diques secos (dry-docks), nuevas instalaciones de espectáculos y programación de ensayos y pruebas de sonido.</li>
                                    <li>Mezcla FOH/MON, monitores in-ear (IEMs), gestión de backline y supervisión de equipos multiculturales asegurando fidelidad absoluta a los estándares de diseño sonoro de Disney.</li>
                                </ul>
                            </div>

                            <div class="exp-item">
                                <h3>Universidad de las Américas Puebla - UDLAP</h3>
                                <span class="exp-date">Junio 2019 - 2022</span>
                                <p class="exp-role"><em>Ingeniero Audiovisual y de Sonido</em></p>
                                <p>Gestión de infraestructura AV, mezcla, iluminación y mantenimiento para auditorio de 600 asientos, sala de cine, salas de conferencias y espacios al aire libre.</p>
                            </div>

                            <div class="exp-item">
                                <h3>Lunario del Auditorio Nacional</h3>
                                <span class="exp-date">Febrero 2020</span>
                                <p class="exp-role"><em>Ingeniero de Audio en Monitores</em></p>
                                <p>Técnico de monitores e ingeniero de audio para la producción musical "All Shook Up".</p>
                            </div>

                            <div class="exp-item">
                                <h3>AIRA Studio</h3>
                                <span class="exp-date">Mayo 2019 - Julio 2019</span>
                                <p class="exp-role"><em>Desarrollo de Electrónica de Audio</em></p>
                                <p>Diseño y desarrollo de electrónica especializada para audio y hardware.</p>
                            </div>

                            <div class="exp-item">
                                <h3>Compañía Folklórica Magisterial de Hidalgo</h3>
                                <span class="exp-date">Abril 2018 - 2022</span>
                                <p class="exp-role"><em>Músico y Coordinador Técnico</em></p>
                                <p>Coordinación técnica y participación musical en giras internacionales: Festival de Folklore en Yilan, Taiwán (2018) y Días del Patrimonio en Sharjah, EAU (2019).</p>
                            </div>

                            <div class="exp-item">
                                <h3>La Casa de la Música de Viena en Puebla</h3>
                                <span class="exp-date">Enero 2018 - Julio 2018</span>
                                <p class="exp-role"><em>Técnico de Audio y Guía de Museo</em></p>
                                <p>Técnico de audio FOH y operaciones del recinto dentro del complejo cultural La Constancia Mexicana.</p>
                            </div>

                            <div class="exp-item">
                                <h3>Econodiesel de Atlixco</h3>
                                <span class="exp-date">2014 - Diciembre 2018</span>
                                <p class="exp-role"><em>Electricista Automotriz</em></p>
                                <p>Diseño de sistemas eléctricos, cableado, diagnóstico de fallas y mantenimiento.</p>
                            </div>

                            <div class="exp-item">
                                <h3>Gran Ensamble Orchestra / Auditorio De La Reforma</h3>
                                <span class="exp-date">Junio 2017 - Diciembre 2017</span>
                                <p class="exp-role"><em>Técnico de Audio FOH y Staff Técnico</em></p>
                                <p>Montaje de escenario, colocación de micrófonos, mezcla de monitores y operación FOH.</p>
                            </div>
                        </div>

                        <!-- Education & Certifications -->
                        <div class="glass-card">
                            <h2>Educación y Certificaciones</h2>
                            
                            <div class="exp-item">
                                <h3>Universidad de las Américas Puebla (UDLAP)</h3>
                                <span class="exp-date">2025</span>
                                <p>Maestría en Comunicación y Medios Digitales.</p>
                            </div>

                            <div class="exp-item">
                                <h3>Tec de Monterrey (ITESM)</h3>
                                <span class="exp-date">2019</span>
                                <p>Ingeniería en Producción Musical.</p>
                            </div>

                            <div class="exp-item">
                                <h3>The College of Central Europe (Brno, República Checa)</h3>
                                <span class="exp-date">2019</span>
                                <p>Certificado de Especialidad en Gestión de Economías Creativas.</p>
                            </div>

                            <div class="exp-item">
                                <h3>CBTIS 16</h3>
                                <span class="exp-date">2014</span>
                                <p>Diploma Técnico en Electricidad y Electrónica.</p>
                            </div>

                            <div class="cert-block">
                                <h3>Cursos y Certificaciones</h3>
                                <ul>
                                    <li><strong>Xperience Makers:</strong> Diplomado en Gestión de Producción con Profesionales de Broadway y Teatros (NY)</li>
                                    <li><strong>Audinate:</strong> Certificación en Protocolo Dante (AoIP)</li>
                                    <li><strong>QSC / Q-SYS:</strong> Certificación y Entrenamiento de Diseñador Q-SYS</li>
                                    <li><strong>Shure:</strong> Certificación en Sistemas Integrados y Micrófonos Inalámbricos</li>
                                    <li><strong>Disney Learning:</strong> Entrenamiento en Liderazgo, Stunts, Pirotecnia y Operaciones Técnicas</li>
                                    <li><strong>Waves & Allen & Heath:</strong> Sistemas SoundGrid y Consolas Digitales SQ/CL5</li>
                                </ul>
                            </div>

                            <div class="cert-block">
                                <h3>Sistemas Técnicos y Habilidades</h3>
                                <ul>
                                    <li><strong>Consolas Digitales y Análogas:</strong> API, Yamaha (CL5/PM), SSL, Allen & Heath, Avid, Behringer, Roland</li>
                                    <li><strong>Sistemas y DSPs:</strong> Q-SYS, AMX, Timecode, AES, Dolby, QLab, RADAR, Clear-Com, Procesadores de Cine</li>
                                    <li><strong>Software y Código:</strong> Pro Tools, QLab, Adobe CC, Python, Java, MS Office, macOS, Ubuntu</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Three Column Grid for Competencies -->
                    <div class="competencies-grid">
                        <div class="glass-card">
                            <h3>Áreas de Especialización</h3>
                            <ul>
                                <li><strong>Arquitectura de Sistemas:</strong> Diseño de sistemas, integración y programación lógica.</li>
                                <li><strong>Diseño Sonoro e Inmersivo:</strong> Diseño acústico y visual holístico con enfoque en integración creativa.</li>
                                <li><strong>DSPs y Procesamiento:</strong> Calibración, sintonización de sistemas, amplificadores y procesamiento digital/análogo.</li>
                                <li><strong>Producción Escénica y Rigging:</strong> Rigging teatral/stunts, pirotecnia, periféricos de show control y logística.</li>
                                <li><strong>Narrativas Mediáticas y Transmedia:</strong> Narrativa digital y transmedia, comportamiento del consumidor y medios estratégicos.</li>
                                <li><strong>Psicoacústica y Acústica:</strong> Análisis de acústica de recintos, dinámica sonora e impacto auditivo.</li>
                            </ul>
                        </div>

                        <div class="glass-card">
                            <h3>Habilidades Personales</h3>
                            <ul>
                                <li>Sensibilidad artística y creativa profunda orientada a la experiencia del espectador.</li>
                                <li>Liderazgo de proyectos y experiencia en gestión, asesoría y coaching de equipos técnicos.</li>
                                <li>Alta adaptabilidad y resiliencia en entornos dinámicos de alta presión y estándar global.</li>
                                <li>Planificación técnica integral y resolución rápida de problemas multidisciplinarios.</li>
                                <li>Mentalidad colaborativa, trabajo en equipo y excelentes habilidades de comunicación.</li>
                                <li>Entusiasta de la programación, inteligencia artificial y nuevas tecnologías.</li>
                            </ul>
                        </div>

                        <div class="glass-card">
                            <h3>Información Clave</h3>
                            <ul>
                                <li><strong>Nacionalidad:</strong> Mexicana</li>
                                <li><strong>Idiomas:</strong> Español (Nativo) e Inglés (Avanzado / C1)</li>
                                <li><strong>Educación:</strong> ITESM, UDLAP</li>
                                <li><strong>Años de Experiencia:</strong> +7 años en la industria AV/Audio y +4 en cruceros internacionales</li>
                                <li><strong>Sistemas Principales:</strong> Q-SYS, Dante (AoIP), AMX, QLab, SSL, Yamaha, Avid, Shure</li>
                            </ul>
                        </div>
                    </div>

                    <!-- Download CV Section -->
                    <div class="glass-card cv-download-card">
                        <h2>Descarga mi CV</h2>
                        <p>Obtén una copia completa de mi currículum profesional en formato PDF.</p>
                        <div class="actions-buttons">
                            <a href={`${base}docs/cvesp.pdf`} class="primary-btn">CV en Español (PDF)</a>
                            <a href={`${base}docs/cving.pdf`} class="primary-btn secondary">CV en Inglés (PDF)</a>
                        </div>
                    </div>

                </div>
            </section>
        </div>
    </div>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

        body, #wrapper {
            background-color: #0f131f !important;
            color: #cbd5e1;
            font-family: 'Inter', sans-serif !important;
        }

        .experience-container {
            width: 100%;
            min-height: 100vh;
            background-color: #0f131f;
        }

        .experience-hero {
            padding: 8rem 2rem 4rem 2rem;
            text-align: center;
            background: linear-gradient(180deg, rgba(15, 19, 31, 0.95) 0%, rgba(21, 27, 43, 0.8) 100%);
            border-bottom: 1px solid rgba(0, 229, 255, 0.15);
        }

        .hero-inner {
            max-width: 1000px;
            margin: 0 auto;
        }

        .hero-badge {
            display: inline-block;
            background: rgba(0, 229, 255, 0.1);
            color: #00e5ff;
            padding: 0.5rem 1.25rem;
            border-radius: 20px;
            font-size: 0.875rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            margin-bottom: 1.5rem;
            border: 1px solid rgba(0, 229, 255, 0.3);
        }

        .hero-title {
            font-size: clamp(2.5rem, 5vw, 4rem);
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 1.5rem;
            letter-spacing: -0.02em;
            line-height: 1.1;
        }

        .hero-subtitle {
            font-size: 1.15rem;
            color: #94a3b8;
            max-width: 800px;
            margin: 0 auto 2rem auto;
            line-height: 1.6;
        }

        .divider-line {
            width: 80px;
            height: 3px;
            background: linear-gradient(90deg, #00e5ff, #8d82c4);
            margin: 0 auto;
            border-radius: 2px;
        }

        .main-content-wrapper {
            padding: 4rem 0;
        }

        .inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        .glass-card {
            background: rgba(21, 27, 43, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 2.5rem;
            margin-bottom: 2.5rem;
            backdrop-filter: blur(10px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            transition: transform 0.25s ease, border-color 0.25s ease;
        }

        .glass-card:hover {
            border-color: rgba(0, 229, 255, 0.3);
        }

        .glass-card h2 {
            color: #00e5ff;
            font-size: 1.8rem;
            margin-bottom: 1.5rem;
            font-weight: 700;
            border-bottom: 1px solid rgba(0, 229, 255, 0.2);
            padding-bottom: 0.5rem;
        }

        .glass-card h3 {
            color: #ffffff;
            font-size: 1.25rem;
            margin-top: 1.5rem;
            margin-bottom: 0.25rem;
            font-weight: 600;
        }

        .exp-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2.5rem;
            margin-bottom: 2.5rem;
        }

        .competencies-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-bottom: 2.5rem;
        }

        .exp-item {
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .exp-item:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .exp-date {
            display: inline-block;
            font-size: 0.85rem;
            font-weight: 600;
            color: #00e5ff;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
        }

        .exp-role {
            color: #94a3b8;
            font-size: 0.95rem;
            margin-bottom: 0.75rem;
        }

        .exp-item ul, .glass-card ul {
            padding-left: 1.25rem;
            color: #cbd5e1;
            line-height: 1.6;
        }

        .exp-item li, .glass-card li {
            margin-bottom: 0.5rem;
        }

        .cert-block {
            margin-top: 2rem;
        }

        .cv-download-card {
            text-align: center;
            background: linear-gradient(135deg, rgba(21, 27, 43, 0.9), rgba(15, 19, 31, 0.95));
            border: 1px solid rgba(0, 229, 255, 0.3);
        }

        .actions-buttons {
            display: flex;
            justify-content: center;
            gap: 1.5rem;
            margin-top: 2rem;
            flex-wrap: wrap;
        }

        .primary-btn {
            display: inline-block;
            background: linear-gradient(135deg, #00e5ff, #0088cc);
            color: #0f131f !important;
            padding: 0.85rem 2.5rem;
            border-radius: 12px;
            font-weight: 600;
            text-decoration: none;
            box-shadow: 0 4px 20px rgba(0, 229, 255, 0.3);
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        .primary-btn.secondary {
            background: transparent;
            color: #00e5ff !important;
            border: 2px solid #00e5ff;
        }

        .primary-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(0, 229, 255, 0.5);
        }

        @media (max-width: 1024px) {
            .exp-grid, .competencies-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .experience-hero {
                padding: 6rem 1rem 3rem 1rem;
            }
            .glass-card {
                padding: 1.5rem;
            }
        }
    </style>
</Layout>
