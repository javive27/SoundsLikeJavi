---
import Layout from '../layouts/Layout.astro';
import MusicToolsEnhanced from '../components/MusicToolsEnhanced.astro';
const base = import.meta.env.BASE_URL;
---

<Layout
    title="Music Tools | Javier Flores"
    description="Collection of interactive music tools developed by Javier Flores."
    lang="en"
    pathEs="music-tools"
    pathEn="music-tools"
>
    <div id="main" class="alt">
        <section id="one">
            <div class="inner">
                <header class="major">
                    <h1>Music Tools</h1>
                </header>
                <MusicToolsEnhanced />
            </div>
        </section>
    </div>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

        body, #wrapper {
            background-color: #0f131f !important;
            color: #e2e8f0;
            font-family: 'Inter', sans-serif !important;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Inter', sans-serif !important;
        }
    </style>
</Layout>
