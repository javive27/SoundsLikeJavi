<script>
    // ==========================================
    // SCRIPT DEL ANALIZADOR DE ESPECTRO (RTA)
    // ==========================================
    let rtaAudioCtx = null;

    const getRtaAudioContext = async () => {
        if (!rtaAudioCtx) {
            rtaAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }
        if (rtaAudioCtx.state === 'suspended') {
            await rtaAudioCtx.resume();
        }
        return rtaAudioCtx;
    };

    const getAWeightingGain = (f) => {
        if (f <= 0) return 0;
        const f2 = f * f;
        const c1 = Math.pow(12194, 2);
        const c2 = Math.pow(20.6, 2);
        const c3 = Math.pow(107.7, 2);
        const c4 = Math.pow(737.9, 2);
        const num = c1 * f2 * f2;
        const den = (f2 + c2) * Math.sqrt((f2 + c3) * (f2 + c4)) * (f2 + c1);
        const ra = num / den;
        return 20 * Math.log10(ra || 1e-8) + 2.00;
    };

    document.addEventListener('DOMContentLoaded', () => {
        const toggleRTABtn = document.getElementById('toggleRTA');
        const captureBtn = document.getElementById('captureBtn');
        const canvas = document.getElementById('rtaCanvas');
        if(!canvas) return; // Prevención si no carga
        const canvasCtx = canvas.getContext('2d');
        
        const peakFreqDisplay = document.getElementById('peakFreqDisplay');
        const peakDbDisplay = document.getElementById('peakDbDisplay');
        const xLabelsContainer = document.getElementById('rtaXLabels');
        const yLabelsContainer = document.getElementById('rtaYLabels');
        const splLiveDisplay = document.getElementById('splLiveDisplay');
        const splLeqDisplay = document.getElementById('splLeqDisplay');

        const weightingSelect = document.getElementById('weightingSelect');
        const dbRangeSelect = document.getElementById('dbRangeSelect');
        const freqRangeSelect = document.getElementById('freqRangeSelect');
        const togglePeakHoldBtn = document.getElementById('togglePeakHold');
        const clearPeakHoldBtn = document.getElementById('clearPeakHold');

        let rtaActive = false;
        let rtaTimerId = null;
        let mediaStream = null;
        let analyserNode = null;
        let sourceNode = null;

        let isPeakHold = true;
        let peakDataArray = null;
        let smoothedDataArray = null;
        let minFreq = 20;
        let maxFreq = 20000;

        let splFast = 0;
        let sumPressureSquared = 0;
        let leqSamples = 0;
        const CALIBRATION_OFFSET = 114;

        canvasCtx.fillStyle = '#0f131f';
        canvasCtx.fillRect(0, 0, canvas.width, canvas.height);

        const resetRTAUI = () => {
            canvasCtx.clearRect(0, 0, canvas.width, canvas.height);
            peakFreqDisplay.innerText = '-- Hz';
            peakDbDisplay.innerText = '-- dB';
            splLiveDisplay.innerText = '--- dB';
            splLeqDisplay.innerText = '--- dB';
        };

        const updateXLabels = () => {
            xLabelsContainer.innerHTML = '';
            if (minFreq === 20 && maxFreq === 20000) {
                xLabelsContainer.innerHTML = '<span>20Hz</span><span>100Hz</span><span>500Hz</span><span>1kHz</span><span>5kHz</span><span>20kHz</span>';
            } else if (maxFreq === 250) {
                xLabelsContainer.innerHTML = '<span>20Hz</span><span>63Hz</span><span>125Hz</span><span>250Hz</span>';
            } else if (minFreq === 250) {
                xLabelsContainer.innerHTML = '<span>250Hz</span><span>1kHz</span><span>2kHz</span><span>4kHz</span>';
            } else {
                xLabelsContainer.innerHTML = `<span>${minFreq}Hz</span><span>${Math.round((minFreq+maxFreq)/2)}Hz</span><span>${maxFreq}Hz</span>`;
            }
        };

        const updateYLabels = () => {
            const [minDb, maxDb] = dbRangeSelect.value.split(',').map(Number);
            const range = maxDb - minDb;
            const steps = 5;
            yLabelsContainer.innerHTML = '';
            for (let i = 0; i < steps; i++) {
                const dbValue = maxDb - (range / (steps - 1)) * i;
                const span = document.createElement('span');
                span.innerText = `${dbValue.toFixed(0)}`;
                yLabelsContainer.appendChild(span);
            }
        };

        updateXLabels();
        updateYLabels();

        dbRangeSelect.addEventListener('change', updateYLabels);
        freqRangeSelect.addEventListener('change', () => {
            [minFreq, maxFreq] = freqRangeSelect.value.split(',').map(Number);
            updateXLabels();
        });

        // Captura
        captureBtn.addEventListener('click', () => {
            const exportCanvas = document.createElement('canvas');
            exportCanvas.width = 900;
            exportCanvas.height = 650;
            const ctx = exportCanvas.getContext('2d');

            ctx.fillStyle = '#0a0d14';
            ctx.fillRect(0, 0, exportCanvas.width, exportCanvas.height);
            ctx.fillStyle = '#00e5ff';
            ctx.font = 'bold 24px system-ui, sans-serif';
            ctx.fillText('RTA & SPL MEASUREMENT REPORT (A-WEIGHTED)', 40, 50);

            ctx.fillStyle = '#ffffff';
            ctx.font = '14px monospace';
            const dateStr = new Date().toLocaleString();
            ctx.fillText(`FECHA: ${dateStr}`, 40, 90);
            ctx.fillText(`RTA MAX HOLD: ${peakFreqDisplay.innerText} @ ${peakDbDisplay.innerText}`, 40, 115);

            ctx.fillStyle = '#0f131f';
            ctx.fillRect(500, 40, 350, 120);
            ctx.strokeStyle = '#00e5ff';
            ctx.strokeRect(500, 40, 350, 120);
            
            ctx.fillStyle = '#888888';
            ctx.font = '14px system-ui';
            ctx.fillText('Live SPL (dBA)', 540, 75);
            ctx.fillText('LAeq', 730, 75);
            
            ctx.fillStyle = '#00e5ff';
            ctx.font = 'bold 28px monospace';
            ctx.fillText(splLiveDisplay.innerText, 540, 115);
            ctx.fillText(splLeqDisplay.innerText, 730, 115);

            const wText = weightingSelect.options[weightingSelect.selectedIndex].text;
            const splText = dbRangeSelect.options[dbRangeSelect.selectedIndex].text;
            const freqText = freqRangeSelect.options[freqRangeSelect.selectedIndex].text;
            const [minDbCap, maxDbCap] = dbRangeSelect.value.split(',').map(Number);
            
            ctx.fillStyle = '#aaaaaa';
            ctx.font = '14px monospace';
            ctx.fillText(`POND: ${wText}`, 40, 145);
            ctx.fillText(`RANGO Y: ${splText}`, 300, 145);
            ctx.fillText(`RANGO X: ${freqText}`, 550, 145);

            ctx.fillStyle = '#888888';
            ctx.font = '12px monospace';
            ctx.textAlign = 'right';
            ctx.fillText(`${maxDbCap}`, 35, 195);
            ctx.fillText(`${minDbCap}`, 35, 565);
            ctx.textAlign = 'left';

            ctx.fillStyle = '#0f131f';
            ctx.fillRect(45, 180, 815, 400);
            ctx.drawImage(canvas, 55, 190, 795, 380);

            ctx.fillStyle = '#888888';
            ctx.font = '12px monospace';
            ctx.fillText(`${minFreq}Hz`, 55, 595);
            ctx.textAlign = 'right';
            ctx.fillText(`${maxFreq}Hz`, 850, 595);
            ctx.textAlign = 'left';

            ctx.fillStyle = '#444444';
            ctx.font = '12px system-ui, sans-serif';
            ctx.fillText('Generado por Javier Flores Audio Engineering Tools (DSP Enhanced)', 40, 630);

            const dataUrl = exportCanvas.toDataURL('image/png');
            const a = document.createElement('a');
            a.href = dataUrl;
            a.download = `Measurement_A_Weighted_${new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19)}.png`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            
            const originalText = captureBtn.innerText;
            captureBtn.innerText = '✔️ GUARDADO';
            captureBtn.style.backgroundColor = 'rgba(0, 229, 255, 0.2)';
            setTimeout(() => {
                captureBtn.innerText = originalText;
                captureBtn.style.backgroundColor = 'transparent';
            }, 2000);
        });

        togglePeakHoldBtn.addEventListener('click', () => {
            isPeakHold = !isPeakHold;
            togglePeakHoldBtn.classList.toggle('active', isPeakHold);
        });

        clearPeakHoldBtn.addEventListener('click', () => {
            if (peakDataArray) peakDataArray.fill(0);
            if (smoothedDataArray) smoothedDataArray.fill(0);
            sumPressureSquared = 0;
            leqSamples = 0;
            if (!rtaActive) resetRTAUI();
        });

        if (toggleRTABtn && canvas) {
            toggleRTABtn.addEventListener('click', async () => {
                await getRtaAudioContext();

                if (rtaActive) {
                    rtaActive = false;
                    if (rtaTimerId) cancelAnimationFrame(rtaTimerId);
                    if (mediaStream) { mediaStream.getTracks().forEach(track => track.stop()); mediaStream = null; }
                    if (sourceNode) sourceNode.disconnect();
                    if (analyserNode) analyserNode.disconnect();
                    resetRTAUI();
                    toggleRTABtn.innerText = 'ACTIVAR MICRÓFONO';
                    toggleRTABtn.classList.remove('active-red');
                } else {
                    try {
                        mediaStream = await navigator.mediaDevices.getUserMedia({ audio: true });
                        sourceNode = rtaAudioCtx.createMediaStreamSource(mediaStream);
                        analyserNode = rtaAudioCtx.createAnalyser();
                        analyserNode.fftSize = 8192; 
                        analyserNode.smoothingTimeConstant = 0.2;
                        
                        const bufferLength = analyserNode.frequencyBinCount;
                        peakDataArray = new Float32Array(bufferLength);
                        smoothedDataArray = new Float32Array(bufferLength);
                        sourceNode.connect(analyserNode);

                        const dataArray = new Uint8Array(bufferLength);
                        const timeDomainArray = new Float32Array(analyserNode.fftSize);
                        const freqResolution = rtaAudioCtx.sampleRate / analyserNode.fftSize;

                        rtaActive = true;
                        toggleRTABtn.innerText = 'DETENER MICRÓFONO';
                        toggleRTABtn.classList.add('active-red');

                        const draw = () => {
                            if (!rtaActive) return;
                            rtaTimerId = requestAnimationFrame(draw);

                            analyserNode.getFloatTimeDomainData(timeDomainArray);
                            let sumSquares = 0;
                            for (let i = 0; i < timeDomainArray.length; i++) { sumSquares += timeDomainArray[i] * timeDomainArray[i]; }
                            let rms = Math.sqrt(sumSquares / timeDomainArray.length);
                            
                            let currentDb = 20 * Math.log10(rms || 1e-8) + CALIBRATION_OFFSET;
                            if (currentDb < 0) currentDb = 0;

                            const timeWeightFactor = parseFloat(weightingSelect.value);
                            if (timeWeightFactor > 0) {
                                splFast = (splFast * timeWeightFactor) + (currentDb * (1 - timeWeightFactor));
                            } else {
                                splFast = currentDb;
                            }

                            sumPressureSquared += Math.pow(10, splFast / 10);
                            leqSamples++;
                            let leq = 10 * Math.log10(sumPressureSquared / leqSamples);

                            splLiveDisplay.innerText = `${splFast.toFixed(1)} dBA`;
                            splLeqDisplay.innerText = `${leq.toFixed(1)} dBA`;

                            const [minDb, maxDb] = dbRangeSelect.value.split(',').map(Number);
                            [minFreq, maxFreq] = freqRangeSelect.value.split(',').map(Number);

                            analyserNode.getByteFrequencyData(dataArray);
                            canvasCtx.clearRect(0, 0, canvas.width, canvas.height);

                            const width = canvas.width;
                            const height = canvas.height;
                            const logMin = Math.log10(minFreq);
                            const logMax = Math.log10(maxFreq);
                            const logRange = logMax - logMin;
                            const numBars = Math.floor(width / 3); 
                            const barWidth = width / numBars;

                            let currentDisplayMax = 0;
                            let currentDisplayMaxHz = 0;
                            let currentDisplayMaxDb = minDb;

                            for (let b = 0; b < numBars; b++) {
                                const xPos = b * barWidth;
                                const frac1 = b / numBars;
                                const frac2 = (b + 1) / numBars;
                                const fStart = Math.pow(10, logMin + frac1 * logRange);
                                const fEnd = Math.pow(10, logMin + frac2 * logRange);
                                const fCenter = Math.sqrt(fStart * fEnd);

                                const binStart = Math.max(0, Math.floor(fStart / freqResolution));
                                const binEnd = Math.min(bufferLength - 1, Math.ceil(fEnd / freqResolution));

                                if (binStart > binEnd) continue;

                                let sumVal = 0;
                                let count = 0;
                                for (let i = binStart; i <= binEnd; i++) {
                                    sumVal += dataArray[i];
                                    count++;
                                }
                                let avgVal = count > 0 ? sumVal / count : 0;

                                const aWeight = getAWeightingGain(fCenter);
                                let weightedVal = avgVal + (aWeight * 0.5);
                                if (weightedVal < 0) weightedVal = 0;
                                if (weightedVal > 255) weightedVal = 255;

                                const spectralFactor = timeWeightFactor > 0 ? timeWeightFactor : 0.2;
                                const invFactor = 1 - spectralFactor;
                                smoothedDataArray[b] = (smoothedDataArray[b] || weightedVal) * spectralFactor + weightedVal * invFactor;
                                const drawVal = smoothedDataArray[b];

                                if (isPeakHold) {
                                    if (drawVal > (peakDataArray[b] || 0)) { peakDataArray[b] = drawVal; }
                                } else {
                                    peakDataArray[b] = 0;
                                }

                                const peakValToCompare = isPeakHold ? peakDataArray[b] : drawVal;
                                const dbValCalc = minDb + (peakValToCompare / 255) * (maxDb - minDb);

                                if (dbValCalc > currentDisplayMaxDb) {
                                    currentDisplayMaxDb = dbValCalc;
                                    currentDisplayMaxHz = fCenter;
                                    currentDisplayMax = peakValToCompare;
                                }

                                const scaleY = (drawVal / 255) * height;
                                canvasCtx.fillStyle = '#00e5ff';
                                canvasCtx.fillRect(xPos, height - scaleY, Math.ceil(barWidth) - 1, scaleY);

                                if (isPeakHold && peakDataArray[b] > 0) {
                                    const peakScaleY = (peakDataArray[b] / 255) * height;
                                    canvasCtx.fillStyle = '#ffffff';
                                    canvasCtx.fillRect(xPos, height - peakScaleY - 2, Math.ceil(barWidth) - 1, 2);
                                }
                            }

                            if (currentDisplayMax > 10) {
                                peakFreqDisplay.innerText = `${currentDisplayMaxHz >= 1000 ? (currentDisplayMaxHz/1000).toFixed(2) + ' kHz' : currentDisplayMaxHz.toFixed(1) + ' Hz'}`;
                                peakDbDisplay.innerText = `${currentDisplayMaxDb.toFixed(1)} dB`;
                            } else {
                                peakFreqDisplay.innerText = '-- Hz';
                                peakDbDisplay.innerText = '-- dB';
                            }
                        };
                        draw();
                    } catch (err) {
                        console.error('Error de micrófono (DSP):', err);
                        alert('No se pudo acceder al micrófono para el analizador.');
                        rtaActive = false;
                    }
                }
            });
        }
    });

    // ==========================================
    // SCRIPT DEL GENERADOR DE TONOS
    // ==========================================
    document.addEventListener('DOMContentLoaded', () => {
        const freqSlider = document.getElementById('freqSlider');
        const freqNumberInput = document.getElementById('freqNumberInput');
        const freqPill = document.getElementById('toneFreqPill');
        const freqMinusBtn = document.getElementById('freqMinusBtn');
        const freqPlusBtn = document.getElementById('freqPlusBtn');
        const spinUpBtn = document.getElementById('freqSpinUp');
        const spinDownBtn = document.getElementById('freqSpinDown');
        
        const playBtn = document.getElementById('tonePlayBtn');
        const waveBtn = document.getElementById('waveTypeBtn');
        const noiseBtn = document.getElementById('noiseTypeBtn');
        const volSlider = document.getElementById('volSlider');

        let genAudioCtx = null;
        let oscillator = null;
        let noiseNode = null;
        let masterGain = null;
        
        let isPlaying = false;
        let currentType = 'sine'; 
        let currentFreq = 440;

        const logMin = Math.log10(20);
        const logMax = Math.log10(20000);
        
        const getFreqFromSlider = (val) => {
            const minSlider = parseFloat(freqSlider.min);
            const maxSlider = parseFloat(freqSlider.max);
            const scale = (val - minSlider) / (maxSlider - minSlider);
            return Math.pow(10, logMin + scale * (logMax - logMin));
        };

        const getSliderFromFreq = (freq) => {
            if(freq < 20) freq = 20;
            if(freq > 20000) freq = 20000;
            const scale = (Math.log10(freq) - logMin) / (logMax - logMin);
            const minSlider = parseFloat(freqSlider.min);
            const maxSlider = parseFloat(freqSlider.max);
            return minSlider + scale * (maxSlider - minSlider);
        };

        const updateFreqUI = (freq, source) => {
            let f = Math.round(freq);
            if (f < 20) f = 20;
            if (f > 20000) f = 20000;
            currentFreq = f;

            if (source !== 'slider') freqSlider.value = getSliderFromFreq(f);
            if (source !== 'input') freqNumberInput.value = f;
            
            freqPill.innerText = `${f} Hz`;
            
            const minSlider = parseFloat(freqSlider.min);
            const maxSlider = parseFloat(freqSlider.max);
            const percent = ((freqSlider.value - minSlider) / (maxSlider - minSlider)) * 100;
            freqPill.style.left = `calc(${percent}% + (${8 - percent * 0.15}px))`; 

            if (oscillator && currentType === 'sine') {
                oscillator.frequency.setTargetAtTime(f, genAudioCtx.currentTime, 0.05);
            }
        };

        freqSlider.addEventListener('input', (e) => updateFreqUI(getFreqFromSlider(e.target.value), 'slider'));
        freqNumberInput.addEventListener('change', (e) => updateFreqUI(parseFloat(e.target.value), 'input'));

        const stepFreq = (dir) => updateFreqUI(currentFreq + dir, 'btn');
        freqMinusBtn.addEventListener('click', () => stepFreq(-1));
        freqPlusBtn.addEventListener('click', () => stepFreq(1));
        spinUpBtn.addEventListener('click', () => stepFreq(1));
        spinDownBtn.addEventListener('click', () => stepFreq(-1));

        updateFreqUI(440, 'init');

        const initGenAudio = () => {
            if(genAudioCtx) return;
            genAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
            masterGain = genAudioCtx.createGain();
            masterGain.gain.value = 0;
            masterGain.connect(genAudioCtx.destination);
        };

        const createNoiseBuffer = () => {
            const bufferSize = genAudioCtx.sampleRate * 2; 
            const buffer = genAudioCtx.createBuffer(1, bufferSize, genAudioCtx.sampleRate);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1; 
            return buffer;
        };

        const startSound = async () => {
            if(!genAudioCtx) initGenAudio();
            if(genAudioCtx.state === 'suspended') await genAudioCtx.resume();

            if (currentType === 'sine') {
                oscillator = genAudioCtx.createOscillator();
                oscillator.type = 'sine';
                oscillator.frequency.value = currentFreq;
                oscillator.connect(masterGain);
                oscillator.start();
            } else {
                noiseNode = genAudioCtx.createBufferSource();
                noiseNode.buffer = createNoiseBuffer();
                noiseNode.loop = true;
                noiseNode.connect(masterGain);
                noiseNode.start();
            }

            const vol = parseFloat(volSlider.value);
            masterGain.gain.setTargetAtTime(vol * vol, genAudioCtx.currentTime, 0.05);
            
            isPlaying = true;
            playBtn.classList.add('is-playing');
            playBtn.innerHTML = `<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M6 6h12v12H6z"/></svg> <span>Detener Tono</span>`;
        };

        const stopSound = () => {
            if(!masterGain) return;
            masterGain.gain.setTargetAtTime(0, genAudioCtx.currentTime, 0.05);
            
            setTimeout(() => {
                if(oscillator) { oscillator.stop(); oscillator.disconnect(); oscillator = null; }
                if(noiseNode) { noiseNode.stop(); noiseNode.disconnect(); noiseNode = null; }
            }, 100);

            isPlaying = false;
            playBtn.classList.remove('is-playing');
            playBtn.innerHTML = `<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M8 5v14l11-7z"/></svg> <span>Reproducir Tono</span>`;
        };

        playBtn.addEventListener('click', () => {
            if (isPlaying) stopSound();
            else startSound();
        });

        const switchType = (type) => {
            if (currentType === type) return;
            currentType = type;
            if (type === 'sine') {
                waveBtn.classList.add('active-wave');
                noiseBtn.classList.remove('active-wave');
            } else {
                noiseBtn.classList.add('active-wave');
                waveBtn.classList.remove('active-wave');
            }
            if (isPlaying) {
                stopSound();
                setTimeout(startSound, 100); 
            }
        };

        waveBtn.addEventListener('click', () => switchType('sine'));
        noiseBtn.addEventListener('click', () => switchType('noise'));

        volSlider.addEventListener('input', (e) => {
            if (masterGain) {
                const val = parseFloat(e.target.value);
                masterGain.gain.setTargetAtTime(val * val, genAudioCtx.currentTime, 0.05);
            }
        });
    });
</script>