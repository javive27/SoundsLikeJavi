---
const { lang = "es" } = Astro.props;
const isEn = lang === "en";
---

<div id="ambient-hud" class="fixed-hud">
    <button id="ambient-toggle-btn" class="hud-circle-btn is-playing" aria-label="Toggle ambient audio">
        
        <!-- SVG para el texto circular giratorio -->
        <svg viewBox="0 0 100 100" class="rotating-text-svg">
            <path id="textPath" d="M 50, 50 m -35, 0 a 35,35 0 1,1 70,0 a 35,35 0 1,1 -70,0" fill="none" />
            <text>
                <textPath href="#textPath" startOffset="0%" id="hud-text-content">
                    {isEn ? "NOW PLAYING • NOW PLAYING • NOW PLAYING • " : "REPRODUCIENDO • REPRODUCIENDO • REPRODUCIENDO • "}
                </textPath>
            </text>
        </svg>

        <!-- Contenedor de la Onda Senoidal con Recorte (MAS infinito) -->
        <div class="wave-container">
            <svg viewBox="0 0 48 24" class="sine-wave-svg" width="72" height="36">
                <!-- La curva abarca 2 periodos matemáticos exactos -->
                <path d="M 0 12 Q 6 2, 12 12 T 24 12 T 36 12 T 48 12" fill="none" stroke="#00e5ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>

    </button>
</div>

<style>
    .fixed-hud {
        position: fixed;
        bottom: 2.5rem;
        right: 2.5rem;
        z-index: 100;
    }

    .hud-circle-btn {
        position: relative;
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: rgba(15, 19, 31, 0.85); /* Fondo oscuro base del portafolio */
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(0, 229, 255, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 4px 25px rgba(0, 0, 0, 0.5), inset 0 0 15px rgba(0, 229, 255, 0.1);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .hud-circle-btn:hover {
        background: rgba(15, 19, 31, 0.95);
        border-color: #00e5ff;
        transform: scale(1.05);
        box-shadow: 0 6px 30px rgba(0, 0, 0, 0.6), 0 0 20px rgba(0, 229, 255, 0.3), inset 0 0 20px rgba(0, 229, 255, 0.2);
    }

    /* --- Animación del Texto Circular --- */
    .rotating-text-svg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        animation: spinText 15s linear infinite;
        pointer-events: none;
    }

    .rotating-text-svg text {
        font-family: monospace, system-ui;
        font-size: 10px;
        font-weight: 600;
        fill: #00e5ff; /* Letras color cyan */
        text-transform: uppercase;
        letter-spacing: 2px;
        transition: fill 0.3s ease;
    }

    @keyframes spinText {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    /* --- Contenedor de Onda para el Movimiento Armónico --- */
    .wave-container {
        width: 36px;
        height: 36px;
        overflow: hidden; /* Oculta la parte extra de la onda */
        display: flex;
        align-items: center;
        justify-content: flex-start;
        position: relative;
        z-index: 2;
    }

    .sine-wave-svg {
        position: absolute;
        left: 0;
        transition: opacity 0.3s ease;
    }

    /* --- Estados Activos (Cuando el audio suena) --- */
    .is-playing.hud-circle-btn {
        box-shadow: 0 0 25px rgba(0, 229, 255, 0.4), inset 0 0 20px rgba(0, 229, 255, 0.2);
    }

    .is-playing .rotating-text-svg {
        animation: spinText 8s linear infinite; /* Gira más rápido al reproducir */
    }

    .is-playing .sine-wave-svg {
        /* Desplaza exactamente -36px (la longitud de 1 ciclo en la proporción actual) para hacer un loop infinito limpio */
        animation: harmonicMotion 1.2s linear infinite;
    }

    @keyframes harmonicMotion {
        0% { transform: translateX(0); }
        100% { transform: translateX(-36px); } 
    }
</style>

<script>
    let ambientCtx = null;
    let isAmbientPlaying = true; // Empieza encendido por defecto
    let isScheduling = false;
    let hasStartedAudio = false;
    
    // Nodos globales
    let masterGain = null;
    let globalFilter = null;
    let delayNode = null;
    let feedbackGain = null;
    let tremoloGain = null;
    let tremoloLFO = null;

    // Secuenciador
    let scheduleTimer = null;
    let nextNoteTime = 0;
    let chordIndex = 0;
    let currentProgression = [];
    const lookahead = 25; // ms
    const scheduleAheadTime = 0.5; // s
    const chordDuration = 5.0; // Segundos entre cada acorde

    const toggleBtn = document.getElementById('ambient-toggle-btn');
    const textContent = document.getElementById('hud-text-content');
    const isEn = document.documentElement.lang === 'en';

    // Textos ajustados
    const textPlaying = isEn ? "NOW PLAYING • NOW PLAYING • NOW PLAYING • " : "REPRODUCIENDO • REPRODUCIENDO • REPRODUCIENDO • ";
    const textIdle = isEn ? "AMBIENT • AMBIENT • AMBIENT • AMBIENT • " : "AMBIENTE • AMBIENTE • AMBIENTE • AMBIENTE • ";

    // Utilidad: Notas MIDI a Frecuencia (A4 = 440Hz)
    const midiToFreq = (m) => 440 * Math.pow(2, (m - 69) / 12);

    // Banco de Progresiones (Notas MIDI)
    const progressions = [
        [ // Progresión 1A: Bbmaj7 – Am7 – Dm7 – G7
            [46, 53, 57, 62, 65], // Bbmaj7 
            [45, 52, 55, 60, 64], // Am7 
            [38, 45, 48, 53, 57], // Dm7 
            [43, 50, 53, 59, 62]  // G7 
        ],
        [ // Progresión 1B: Bbmaj7 – A7 – Dm7 – G7 (con variación Dm7 cierre)
            [46, 53, 57, 62, 65], // Bbmaj7
            [45, 52, 55, 61, 64], // A7 
            [38, 45, 48, 53, 57], // Dm7
            [43, 50, 53, 59, 62], // G7
            [38, 45, 48, 53, 57]  // Dm7 extra
        ],
        [ // Progresión 2: Am — G/B — F — Dm — F — G — Em — Em
            [45, 52, 57, 60], // Am 
            [47, 55, 59, 62], // G/B 
            [41, 53, 57, 60], // F 
            [38, 50, 53, 57], // Dm 
            [41, 53, 57, 60], // F
            [43, 55, 59, 62], // G
            [40, 52, 55, 59], // Em 
            [40, 52, 55, 59]  // Em
        ],
        [ // Progresión 3: B – F#m7 – Emaj7 – D#m7 – C#m7 – E/F#
            [47, 54, 59, 63], // B 
            [42, 52, 57, 61], // F#m7 
            [40, 51, 56, 59], // Emaj7 
            [39, 51, 54, 58], // D#m7 
            [37, 47, 52, 56], // C#m7 
            [42, 52, 56, 59]  // E/F# 
        ]
    ];

    // Sintetizador de Piano Rhodes Melancólico
    const playRhodesNote = (freq, time, duration) => {
        if (!ambientCtx) return;

        const oscSine = ambientCtx.createOscillator();
        const oscTri = ambientCtx.createOscillator();
        const noteGain = ambientCtx.createGain();

        oscSine.type = 'sine';
        oscTri.type = 'triangle';
        oscSine.frequency.value = freq;
        oscTri.frequency.value = freq;

        const sineGain = ambientCtx.createGain();
        const triGain = ambientCtx.createGain();
        sineGain.gain.value = 0.7; 
        triGain.gain.value = 0.3; 

        oscSine.connect(sineGain);
        oscTri.connect(triGain);
        sineGain.connect(noteGain);
        triGain.connect(noteGain);

        noteGain.connect(tremoloGain);
        noteGain.connect(delayNode); 

        // Envolvente ADSR (Ataque percusivo suave, caída larga)
        noteGain.gain.setValueAtTime(0, time);
        noteGain.gain.linearRampToValueAtTime(0.2, time + 0.05); 
        noteGain.gain.exponentialRampToValueAtTime(0.05, time + 1.5); 
        noteGain.gain.linearRampToValueAtTime(0, time + duration); 

        oscSine.start(time);
        oscTri.start(time);
        oscSine.stop(time + duration);
        oscTri.stop(time + duration);
    };

    // Funciones del Secuenciador
    const nextChord = () => {
        const chord = currentProgression[chordIndex];
        
        chord.forEach((midiNote) => {
            const freq = midiToFreq(midiNote);
            const humanizeOffset = Math.random() * 0.15; // Ligero strum aleatorio
            playRhodesNote(freq, nextNoteTime + humanizeOffset, chordDuration * 1.8);
        });

        nextNoteTime += chordDuration;
        chordIndex = (chordIndex + 1) % currentProgression.length;
    };

    const scheduler = () => {
        isScheduling = true;
        while (nextNoteTime < ambientCtx.currentTime + scheduleAheadTime) {
            nextChord();
        }
        scheduleTimer = setTimeout(scheduler, lookahead);
    };

    // Inicialización del Motor de Audio
    const initAmbientAudio = () => {
        if (ambientCtx) return;
        ambientCtx = new (window.AudioContext || window.webkitAudioContext)();
        
        masterGain = ambientCtx.createGain();
        masterGain.gain.value = 0; 

        globalFilter = ambientCtx.createBiquadFilter();
        globalFilter.type = 'lowpass';
        globalFilter.frequency.value = 600; 

        tremoloGain = ambientCtx.createGain();
        tremoloLFO = ambientCtx.createOscillator();
        tremoloLFO.type = 'sine';
        tremoloLFO.frequency.value = 4.5; 
        
        const tremoloDepth = ambientCtx.createGain();
        tremoloDepth.gain.value = 0.15; 
        
        tremoloLFO.connect(tremoloDepth);
        tremoloDepth.connect(tremoloGain.gain);
        tremoloLFO.start();

        delayNode = ambientCtx.createDelay();
        delayNode.delayTime.value = 0.75; 
        feedbackGain = ambientCtx.createGain();
        feedbackGain.gain.value = 0.5; 

        delayNode.connect(feedbackGain);
        feedbackGain.connect(delayNode);
        
        tremoloGain.connect(globalFilter);
        delayNode.connect(globalFilter);
        globalFilter.connect(masterGain);
        masterGain.connect(ambientCtx.destination);
    };

    // LÓGICA DE AUTOPLAY: Reanuda el contexto en la primera interacción del usuario
    const startAudioOnInteract = async () => {
        if (hasStartedAudio) return;
        if (ambientCtx && ambientCtx.state === 'suspended' && isAmbientPlaying) {
            await ambientCtx.resume();
            currentProgression = progressions[Math.floor(Math.random() * progressions.length)];
            chordIndex = 0;
            nextNoteTime = ambientCtx.currentTime + 0.1;
            masterGain.gain.setTargetAtTime(0.8, ambientCtx.currentTime, 1);
            if (!isScheduling) scheduler();
            hasStartedAudio = true;
        }
        window.removeEventListener('click', startAudioOnInteract);
        window.removeEventListener('scroll', startAudioOnInteract);
        window.removeEventListener('keydown', startAudioOnInteract);
    };

    // Iniciar el sistema en estado "Pre-Play"
    initAmbientAudio();
    window.addEventListener('click', startAudioOnInteract);
    window.addEventListener('scroll', startAudioOnInteract);
    window.addEventListener('keydown', startAudioOnInteract);

    // Control de Reproducción al presionar el Botón
    if (toggleBtn) {
        toggleBtn.addEventListener('click', async (e) => {
            e.stopPropagation(); // Evita que se dispare junto con el startAudioOnInteract
            if (!ambientCtx) initAmbientAudio();
            
            isAmbientPlaying = !isAmbientPlaying;

            if (isAmbientPlaying) {
                if (ambientCtx.state === 'suspended') await ambientCtx.resume();
                currentProgression = progressions[Math.floor(Math.random() * progressions.length)];
                chordIndex = 0;
                nextNoteTime = ambientCtx.currentTime + 0.1;

                masterGain.gain.setTargetAtTime(0.8, ambientCtx.currentTime, 1);
                toggleBtn.classList.add('is-playing');
                textContent.textContent = textPlaying;
                
                if (!isScheduling) scheduler(); 
                hasStartedAudio = true;
            } else {
                masterGain.gain.setTargetAtTime(0, ambientCtx.currentTime, 0.5);
                toggleBtn.classList.remove('is-playing');
                textContent.textContent = textIdle;
                
                isScheduling = false;
                clearTimeout(scheduleTimer); 
            }
        });
    }

    // Interactividad con el Scroll
    window.addEventListener('scroll', () => {
        if (ambientCtx && isAmbientPlaying && globalFilter) {
            const scrollY = window.scrollY;
            const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
            const scrollProgress = Math.min(1, Math.max(0, scrollY / maxScroll));

            const targetFreq = 600 + (scrollProgress * 2400);
            globalFilter.frequency.setTargetAtTime(targetFreq, ambientCtx.currentTime, 0.1);
        }
    });
</script>