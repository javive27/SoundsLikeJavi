---
const { lang = "es" } = Astro.props;
const isEn = lang === "en";
---

<div id="ambient-hud" class="fixed-hud">
    <div class="spotify-hidden-wrapper">
        <div id="spotify-invisible-player"></div>
    </div>

    <button id="ambient-toggle-btn" class="hud-circle-btn" aria-label="Toggle Spotify Audio">
        
        <svg viewBox="0 0 100 100" class="rotating-text-svg">
            <path id="textPath" d="M 50, 50 m -35, 0 a 35,35 0 1,1 70,0 a 35,35 0 1,1 -70,0" fill="none" />
            <text>
                <textPath href="#textPath" startOffset="0%" id="hud-text-content">
                    {isEn ? "CURATED PLAYLIST • " : "LISTA CURADA • "}
                </textPath>
            </text>
        </svg>

        <div class="wave-container">
            <svg viewBox="0 0 72 24" class="sine-wave-svg" width="72" height="24">
                <path d="M 0 12 Q 9 2, 18 12 T 36 12 Q 45 2, 54 12 T 72 12" fill="none" stroke="#00e5ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>

    </button>
</div>

<script src="https://open.spotify.com/embed/iframe-api/v1" async></script>

<style>
    .fixed-hud {
        position: fixed;
        bottom: 2.5rem;
        right: 2.5rem;
        z-index: 100;
    }

    .spotify-hidden-wrapper {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
        opacity: 0;
        pointer-events: none;
    }

    .hud-circle-btn {
        position: relative;
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: rgba(15, 19, 31, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(0, 229, 255, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 4px 25px rgba(0, 0, 0, 0.5), inset 0 0 15px rgba(0, 229, 255, 0.1);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        opacity: 0.5;
        pointer-events: none;
    }

    .hud-circle-btn.is-ready {
        opacity: 1;
        pointer-events: auto;
    }

    .hud-circle-btn:hover {
        background: rgba(15, 19, 31, 0.95);
        border-color: #00e5ff;
        transform: scale(1.05);
        box-shadow: 0 6px 30px rgba(0, 0, 0, 0.6), 0 0 20px rgba(0, 229, 255, 0.4), inset 0 0 20px rgba(0, 229, 255, 0.2);
    }

    .rotating-text-svg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        animation: spinText 20s linear infinite;
        pointer-events: none;
    }

    .rotating-text-svg text {
        font-family: monospace, system-ui;
        font-size: 8px;
        font-weight: 600;
        fill: #00e5ff;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: fill 0.3s ease;
    }

    @keyframes spinText {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .wave-container {
        width: 36px;
        height: 24px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        position: relative;
        z-index: 2;
    }

    .sine-wave-svg {
        position: absolute;
        left: 0;
        transition: opacity 0.3s ease;
        opacity: 0.3;
    }

    /* Activación del movimiento basada puramente en la clase is-playing */
    .hud-circle-btn.is-playing {
        border-color: #00e5ff;
        box-shadow: 0 0 25px rgba(0, 229, 255, 0.6), inset 0 0 20px rgba(0, 229, 255, 0.3);
    }

    .hud-circle-btn.is-playing .rotating-text-svg {
        animation: spinText 10s linear infinite;
    }

    .hud-circle-btn.is-playing .sine-wave-svg {
        opacity: 1;
        animation: harmonicMotion 1.2s linear infinite;
    }

    @keyframes harmonicMotion {
        0% { transform: translateX(0); }
        100% { transform: translateX(-36px); } 
    }
</style>

<script>
    const PLAYLIST_ID = '06ENdYdT8sOg2eYrnjxoPP'; 

    const isEn = document.documentElement.lang === 'en';
    const textPlay = isEn ? "CURATED PLAYLIST • " : "LISTA CURADA • ";
    const prefixNowPlaying = isEn ? "NOW PLAYING: " : "SONANDO: ";

    let embedController = null;

    const fitTextToCircle = (text) => {
        const targetCharLength = 42;
        if (!text) return "";
        let formatted = text.trim();
        if (!formatted.endsWith("•")) formatted += " • ";
        
        if (formatted.length >= targetCharLength) {
            return formatted.substring(0, targetCharLength - 3) + "... • ";
        }
        
        const repeats = Math.floor(targetCharLength / formatted.length);
        let result = formatted.repeat(repeats);
        
        while (result.length < targetCharLength - formatted.length / 2) {
            result += formatted;
        }
        return result;
    };

    function initPlayer(IFrameAPI) {
        const element = document.getElementById('spotify-invisible-player');
        if (!element) return;

        const options = {
            uri: `spotify:playlist:${PLAYLIST_ID}`,
            width: '100%',
            height: '152',
            theme: 'dark'
        };

        const callback = (EmbedController) => {
            embedController = EmbedController;
            const toggleBtn = document.getElementById('ambient-toggle-btn');
            const textContent = document.getElementById('hud-text-content');

            if (toggleBtn && textContent) {
                toggleBtn.classList.add('is-ready');
                textContent.textContent = fitTextToCircle(textPlay);

                // Clic limpio: solo manda la orden a Spotify, no manipula CSS
                toggleBtn.addEventListener('click', () => {
                    if (embedController) {
                        embedController.togglePlay();
                    }
                });

                // Spotify como fuente de verdad: el CSS responde solo al estado real del reproductor
                embedController.addListener('playback_update', e => {
                    const state = e.data;
                    if (!state) return;
                    
                    const isActuallyPlaying = !state.isPaused;

                    if (isActuallyPlaying) {
                        toggleBtn.classList.add('is-playing');
                        if (state.track && state.track.name) {
                            const trackName = state.track.name.toUpperCase();
                            const fullText = `${prefixNowPlaying}${trackName}`;
                            textContent.textContent = fitTextToCircle(fullText);
                        }
                    } else {
                        toggleBtn.classList.remove('is-playing');
                        textContent.textContent = fitTextToCircle(textPlay);
                    }
                });
            }
        };

        try {
            IFrameAPI.createController(element, options, callback);
        } catch (err) {
            console.error("Spotify IFrame API error:", err);
        }
    }

    window.onSpotifyIframeApiReady = (IFrameAPI) => {
        initPlayer(IFrameAPI);
    };

    setTimeout(() => {
        const toggleBtn = document.getElementById('ambient-toggle-btn');
        const textContent = document.getElementById('hud-text-content');
        if (toggleBtn && !toggleBtn.classList.contains('is-ready')) {
            toggleBtn.classList.add('is-ready');
            if (textContent) {
                textContent.textContent = fitTextToCircle(textPlay);
            }
        }
    }, 4000);
</script>