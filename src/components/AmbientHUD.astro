---
const { lang = "es" } = Astro.props;
const isEn = lang === "en";
---

<div id="ambient-hud" class="fixed-hud">
    <!-- Contenedor fuera de pantalla con dimensiones reales para que Spotify IFrame API funcione correctamente -->
    <div id="spotify-invisible-player" class="spotify-offscreen-container"></div>

    <button id="ambient-toggle-btn" class="hud-circle-btn" aria-label="Toggle Spotify Audio">
        
        <!-- SVG para el texto circular giratorio -->
        <svg viewBox="0 0 100 100" class="rotating-text-svg">
            <path id="textPath" d="M 50, 50 m -35, 0 a 35,35 0 1,1 70,0 a 35,35 0 1,1 -70,0" fill="none" />
            <text>
                <textPath href="#textPath" startOffset="0%" id="hud-text-content">
                    {isEn ? "LOADING MUSIC • LOADING MUSIC • " : "CARGANDO MÚSICA • CARGANDO MÚSICA • "}
                </textPath>
            </text>
        </svg>

        <!-- Contenedor de la Onda -->
        <div class="wave-container">
            <svg viewBox="0 0 48 24" class="sine-wave-svg" width="72" height="36">
                <path d="M 0 12 Q 6 2, 12 12 T 24 12 T 36 12 T 48 12" fill="none" stroke="#00e5ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>

    </button>
</div>

<!-- Cargamos la API de Spotify -->
<script src="https://open.spotify.com/embed/iframe-api/v1" async></script>

<style>
    .fixed-hud {
        position: fixed;
        bottom: 2.5rem;
        right: 2.5rem;
        z-index: 100;
    }

    /* Contenedor off-screen con tamaño real para que Spotify API renderice y reproduzca audio sin problemas */
    .spotify-offscreen-container {
        position: absolute;
        left: -9999px;
        top: 0;
        width: 300px;
        height: 380px;
        opacity: 0.01;
        pointer-events: none;
        overflow: hidden;
    }

    .hud-circle-btn {
        position: relative;
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: rgba(15, 19, 31, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(0, 229, 255, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 4px 25px rgba(0, 0, 0, 0.5), inset 0 0 15px rgba(0, 229, 255, 0.1);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        opacity: 0.5;
        pointer-events: none; /* Desactivado hasta que cargue Spotify */
    }

    .hud-circle-btn.is-ready {
        opacity: 1;
        pointer-events: auto;
    }

    .hud-circle-btn:hover {
        background: rgba(15, 19, 31, 0.95);
        border-color: #00e5ff;
        transform: scale(1.05);
        box-shadow: 0 6px 30px rgba(0, 0, 0, 0.6), 0 0 20px rgba(0, 229, 255, 0.3), inset 0 0 20px rgba(0, 229, 255, 0.2);
    }

    .rotating-text-svg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        animation: spinText 20s linear infinite;
        pointer-events: none;
    }

    .rotating-text-svg text {
        font-family: monospace, system-ui;
        font-size: 9.5px;
        font-weight: 600;
        fill: #00e5ff;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        transition: fill 0.3s ease;
    }

    @keyframes spinText {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .wave-container {
        width: 36px;
        height: 36px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        position: relative;
        z-index: 2;
    }

    .sine-wave-svg {
        position: absolute;
        left: 0;
        transition: opacity 0.3s ease;
        opacity: 0.3;
    }

    /* Estados de Reproducción Activa */
    .is-playing.hud-circle-btn {
        box-shadow: 0 0 25px rgba(0, 229, 255, 0.4), inset 0 0 20px rgba(0, 229, 255, 0.2);
    }

    .is-playing .rotating-text-svg {
        animation: spinText 12s linear infinite;
    }

    .is-playing .sine-wave-svg {
        opacity: 1;
        animation: harmonicMotion 1s linear infinite;
    }

    @keyframes harmonicMotion {
        0% { transform: translateX(0); }
        100% { transform: translateX(-36px); } 
    }
</style>

<script>
    // ID de tu lista de reproducción de French House / Daft Punk vibe
    const PLAYLIST_ID = '06ENdYdT8sOg2eYrnjxoPP'; 

    const isEn = document.documentElement.lang === 'en';
    const textPlay = "CURATED PLAYLIST • CURATED PLAYLIST • ";
    const prefixNowPlaying = isEn ? "NOW PLAYING: " : "SONANDO: ";

    let embedController = null;
    let isPlaying = false;

    // Función para repetir el texto hasta que llene el círculo SVG
    const fillCircleWithText = (text) => {
        const targetLength = 65; 
        if (text.length >= targetLength) return text;
        const repeats = Math.ceil(targetLength / text.length);
        return text.repeat(repeats);
    };

    function initPlayer(IFrameAPI) {
        const element = document.getElementById('spotify-invisible-player');
        if (!element) return;
        
        const options = {
            uri: `spotify:playlist:${PLAYLIST_ID}`,
            width: 300,
            height: 380,
            theme: 'dark'
        };

        const callback = (EmbedController) => {
            embedController = EmbedController;
            const toggleBtn = document.getElementById('ambient-toggle-btn');
            const textContent = document.getElementById('hud-text-content');

            if (toggleBtn && textContent) {
                // Habilitar el botón cuando la API está lista
                toggleBtn.classList.add('is-ready');
                textContent.textContent = fillCircleWithText(textPlay);

                // Al hacer clic, alternar reproducción
                toggleBtn.addEventListener('click', () => {
                    if (embedController && typeof embedController.togglePlay === 'function') {
                        embedController.togglePlay();
                    }
                });

                // Escuchar cambios en la pista o pausa/reproducción
                embedController.addListener('playback_update', e => {
                    const state = e.data;
                    if (!state) return;
                    isPlaying = !state.isPaused;

                    if (isPlaying && state.track && state.track.name) {
                        toggleBtn.classList.add('is-playing');
                        const trackName = state.track.name.toUpperCase();
                        const fullText = `${prefixNowPlaying}${trackName} • `;
                        textContent.textContent = fillCircleWithText(fullText);
                    } else {
                        toggleBtn.classList.remove('is-playing');
                        textContent.textContent = fillCircleWithText(textPlay);
                    }
                });
            }
        };

        try {
            IFrameAPI.createController(element, options, callback);
        } catch (err) {
            console.error("Spotify IFrame API error:", err);
            const toggleBtn = document.getElementById('ambient-toggle-btn');
            const textContent = document.getElementById('hud-text-content');
            if (toggleBtn && textContent) {
                toggleBtn.classList.add('is-ready');
                textContent.textContent = fillCircleWithText(isEn ? "PLAYLIST • " : "PLAYLIST • ");
            }
        }
    }

    window.onSpotifyIframeApiReady = (IFrameAPI) => {
        initPlayer(IFrameAPI);
    };

    // Safety fallback in case the API callback doesn't fire
    setTimeout(() => {
        const toggleBtn = document.getElementById('ambient-toggle-btn');
        const textContent = document.getElementById('hud-text-content');
        if (toggleBtn && !toggleBtn.classList.contains('is-ready')) {
            toggleBtn.classList.add('is-ready');
            if (textContent) {
                textContent.textContent = fillCircleWithText(isEn ? "PLAYLIST • " : "PLAYLIST • ");
            }
        }
    }, 4000);
</script>
