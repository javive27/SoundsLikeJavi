    }
    .mt-btn-cyan { border: 2px solid #00e5ff; color: #fff; }
    .mt-btn-cyan:hover { background: #00e5ff; color: #0f131f; }
    .mt-btn.active-red { border-color: #ff3366; color: #fff; }
    .mt-btn.active-red:hover { background: #ff3366; color: #fff; }
    .mb-spaced { margin-bottom: 2rem; }

    /* --- Afinador --- */
    .calibration-row {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin-bottom: 1.5rem;
        color: #888;
        font-size: 0.9rem;
    }
    .calibration-row input { width: 70px; text-align: center; }
    .tuner-display { margin-bottom: 2rem; }
    .note-text { font-size: 5rem; font-weight: 900; color: #555; line-height: 1; transition: color 0.15s; }
    .cents-text { color: #888; font-size: 0.9rem; font-family: monospace; margin-top: 0.5rem; }

    /* Dial del Afinador */
    .dial-container {
        position: relative;
        width: 100%;
        height: 48px;
        background: rgba(0, 0, 0, 0.4);
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        overflow: hidden;
    }
    .dial-ticks {
        position: absolute; width: 100%; height: 100%;
        display: flex; justify-content: space-between; align-items: flex-start;
        padding: 0 10px; box-sizing: border-box; z-index: 0;
    }
    .tick { width: 2px; height: 8px; background: rgba(255, 255, 255, 0.15); }
    .tick.major { height: 16px; background: rgba(255, 255, 255, 0.3); }
    .dial-center-mark {
        position: absolute; width: 2px; height: 100%; background: rgba(255, 255, 255, 0.1);
        left: 50%; transform: translateX(-50%); z-index: 1;
    }
