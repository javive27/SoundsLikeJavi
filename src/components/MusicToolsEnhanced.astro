    .slider-container { margin-bottom: 2rem; padding: 0 10px; }
    .mt-slider { -webkit-appearance: none; width: 100%; background: transparent; }
    .mt-slider:focus { outline: none; }
    .mt-slider::-webkit-slider-runnable-track {
        width: 100%;
