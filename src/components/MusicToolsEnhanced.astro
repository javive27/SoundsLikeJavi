    }
    .mt-slider::-webkit-slider-thumb {
        height: 24px;
        width: 24px;
        border-radius: 50%;
        background: #00e5ff;
        cursor: pointer;
        -webkit-appearance: none;
        margin-top: -8px;
        box-shadow: 0 0 10px rgba(0, 229, 255, 0.5);
    }

    /* --- Botones Generales --- */
    .mt-btn {
        width: 100%;
        padding: 14px 24px;
        font-size: 1rem;
        font-weight: bold;
        letter-spacing: 2px;
        text-transform: uppercase;
        border-radius: 8px;
