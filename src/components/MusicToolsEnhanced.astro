        padding: 0 16px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: bold;
        font-size: 0.85rem;
        letter-spacing: 1px;
        transition: all 0.2s;
        /* Flexbox para centrar texto dentro del botón */
        display: inline-flex;
