<div class="music-tools-wrapper">
    <!-- Metrónomo -->
    <div class="mt-card">
        <h2 class="mt-title">Metrónomo</h2>
        
        <!-- Contenedor superior con CSS Grid para alineación perfecta -->
        <div class="mt-controls-grid">
            
            <div class="compas-wrapper">
                <select id="timeSignature" class="mt-select">
                    <option value="1">1/4</option>
                    <option value="2">2/4</option>
                    <option value="3">3/4</option>
                    <option value="4" selected>4/4</option>
                    <option value="5">5/4</option>
                    <option value="6">6/8</option>
                </select>
            </div>

            <div class="led-wrapper">
                <div id="beatLight" class="led-light"></div>
            </div>

            <div class="tap-wrapper">
                <button id="tapTempoBtn" class="mt-btn-small">TAP TEMPO</button>
            </div>
        </div>

        <div class="bpm-container">
            <input type="number" id="bpmInput" class="bpm-input" value="120" min="40" max="300">
            <span class="bpm-label">BPM</span>
        </div>

        <div class="slider-container">
            <input type="range" id="bpmSlider" min="40" max="300" value="120" class="mt-slider">
        </div>

        <button id="toggleMetronome" class="mt-btn mt-btn-cyan">INICIAR</button>
    </div>

    <!-- Afinador Cromático -->
    <div class="mt-card">
        <h2 class="mt-title">Afinador Cromático</h2>
        
        <div class="calibration-row">
            <label>Ref A4:</label>
            <input type="number" id="a4Input" class="mt-input-sm" value="440" min="410" max="460"> <span>Hz</span>
        </div>

        <button id="toggleTuner" class="mt-btn mt-btn-cyan mb-spaced">ACTIVAR MICRÓFONO</button>

        <div class="tuner-display">
            <div id="noteDisplay" class="note-text">--</div>
            <div id="centsDisplay" class="cents-text">0 cents</div>
        </div>

        <!-- Indicador Dial/Aguja -->
        <div class="dial-container">
            <div class="dial-ticks">
                <div class="tick major"></div>
                <div class="tick"></div>
                <div class="tick"></div>
                <div class="tick"></div>
                <div class="tick"></div>
                <div class="tick major"></div>
                <div class="tick"></div>
                <div class="tick"></div>
                <div class="tick"></div>
                <div class="tick"></div>
                <div class="tick major"></div>
            </div>
            <div class="dial-center-mark"></div>
            <div class="dial-labels">
                <span>-50</span>
                <span>0</span>
                <span>+50</span>
            </div>
            <div id="needle" class="dial-needle"></div>
        </div>
    </div>

    <!-- Piano Synth -->
    <div class="mt-card">
        <h2 class="mt-title">Mini Piano</h2>
        <p class="piano-hint">Usa el teclado: Q a P (blancas), Num 2 a 0 (negras)</p>
        <div class="piano-wrapper">
            <div class="piano-key white" data-key="q" data-freq="261.63"><span>Q</span></div>
            <div class="piano-key black" data-key="2" data-freq="277.18"><span>2</span></div>
            <div class="piano-key white" data-key="w" data-freq="293.66"><span>W</span></div>
            <div class="piano-key black" data-key="3" data-freq="311.13"><span>3</span></div>
            <div class="piano-key white" data-key="e" data-freq="329.63"><span>E</span></div>
            <div class="piano-key white" data-key="r" data-freq="349.23"><span>R</span></div>
            <div class="piano-key black" data-key="5" data-freq="369.99"><span>5</span></div>
            <div class="piano-key white" data-key="t" data-freq="392.00"><span>T</span></div>
            <div class="piano-key black" data-key="6" data-freq="415.30"><span>6</span></div>
            <div class="piano-key white" data-key="y" data-freq="440.00"><span>Y</span></div>
            <div class="piano-key black" data-key="7" data-freq="466.16"><span>7</span></div>
            <div class="piano-key white" data-key="u" data-freq="493.88"><span>U</span></div>
            <div class="piano-key white" data-key="i" data-freq="523.25"><span>I</span></div>
            <div class="piano-key black" data-key="9" data-freq="554.37"><span>9</span></div>
            <div class="piano-key white" data-key="o" data-freq="587.33"><span>O</span></div>
            <div class="piano-key black" data-key="0" data-freq="622.25"><span>0</span></div>
            <div class="piano-key white" data-key="p" data-freq="659.25"><span>P</span></div>
        </div>
    </div>
</div>

<style>
