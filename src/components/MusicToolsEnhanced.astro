    /* --- Mini Piano --- */
    .piano-hint { color: #888; font-size: 0.85rem; margin-bottom: 1.5rem; }
    .piano-wrapper {
        display: flex; position: relative; justify-content: center;
        height: 160px; width: 100%; background: #111; padding: 10px 10px 0 10px;
        border-radius: 8px; border: 2px solid #333; box-sizing: border-box; overflow: hidden;
    }
    .piano-key {
        cursor: pointer; display: flex; align-items: flex-end; justify-content: center;
        padding-bottom: 10px; user-select: none; transition: background 0.05s;
        border-radius: 0 0 4px 4px; border: 1px solid #000;
    }
    .piano-key span { pointer-events: none; }
    .piano-key.white {
        background: #fffff0; color: #333; width: 45px; height: 100%; z-index: 1;
        font-weight: bold; box-shadow: inset 0 -2px 5px rgba(0,0,0,0.2);
    }
    .piano-key.white.active {
        background: #e0e0d0; box-shadow: inset 0 -1px 2px rgba(0,0,0,0.4);
        transform: scaleY(0.98); transform-origin: top;
    }
    .piano-key.black {
        background: #111; color: #aaa; width: 30px; height: 60%; margin-left: -15px; margin-right: -15px;
        z-index: 2; font-size: 0.75rem; box-shadow: inset 0 -3px 5px rgba(255,255,255,0.1), 2px 2px 5px rgba(0,0,0,0.5);
    }
    .piano-key.black.active {
        background: #333; box-shadow: inset 0 -1px 2px rgba(255,255,255,0.1);
        transform: scaleY(0.98); transform-origin: top;
    }
</style>

<script>
    // ==========================================
    // --- LÓGICA DEL METRÓNOMO ---
    // ==========================================
    let metronomeCtx = null;
    let bpm = 120;
    let playing = false;
    let nextTickTime = 0;
    let timerId = null;
    let currentBeat = 0;
    let tapTimes = [];

    const playClick = (time, isAccent) => {
        if (!metronomeCtx) return;

        const timeToPlay = time - metronomeCtx.currentTime;
        const triggerLed = () => {
            const led = document.getElementById('beatLight');
            led.classList.add('active');
            
            // Todo se prende en Cyan como solicitaste
            led.style.backgroundColor = '#00e5ff';
            led.style.borderColor = '#00e5ff';
            
            // Acentos brillan un poco más para mantener el feel
            if (isAccent) {
                led.style.boxShadow = '0 0 20px #00e5ff, inset 0 0 10px #fff';
            } else {
                led.style.boxShadow = '0 0 10px #00e5ff';
            }
            
            setTimeout(() => {
                led.classList.remove('active');
                led.style.backgroundColor = '';
                led.style.borderColor = '';
                led.style.boxShadow = '';
            }, 100);
        };

        if (timeToPlay > 0) {
            setTimeout(triggerLed, timeToPlay * 1000);
        } else {
            triggerLed();
        }

        const osc = metronomeCtx.createOscillator();
        const gain = metronomeCtx.createGain();

        osc.type = 'sine';
        osc.frequency.setValueAtTime(isAccent ? 1500 : 1000, time); 
        
        gain.gain.setValueAtTime(1, time);
        gain.gain.exponentialRampToValueAtTime(0.001, time + 0.05);

        osc.connect(gain);
        gain.connect(metronomeCtx.destination);

        osc.start(time);
        osc.stop(time + 0.05);
    };

    const scheduler = () => {
        while (nextTickTime < metronomeCtx.currentTime + 0.1) {
            const timeSig = parseInt(document.getElementById('timeSignature').value);
            const isAccent = (currentBeat % timeSig === 0);
            
            playClick(nextTickTime, isAccent);
            nextTickTime += 60.0 / bpm;
            currentBeat++;
        }
        if (playing) {
            timerId = requestAnimationFrame(scheduler);
        }
    };

    // ==========================================
    // --- LÓGICA DEL AFINADOR ---
    // ==========================================
    let tunerCtx = null;
    
    const autoCorrelate = (buffer, sampleRate) => {
        const SIZE = buffer.length;
        let sumOfSquares = 0;
        for (let i = 0; i < SIZE; i++) sumOfSquares += buffer[i] * buffer[i];
        const rms = Math.sqrt(sumOfSquares / SIZE);
        if (rms < 0.01) return -1; 

        const minSamples = Math.floor(sampleRate / 1200);
        const maxSamples = Math.floor(sampleRate / 60);
        let bestLag = -1;
        let maxCorr = 0;

        for (let lag = minSamples; lag <= maxSamples; lag++) {
            let corr = 0;
            for (let i = 0; i < SIZE - lag; i++) {
                corr += buffer[i] * buffer[i + lag];
            }
            if (corr > maxCorr) {
                maxCorr = corr;
                bestLag = lag;
            }
        }
        if (maxCorr / sumOfSquares > 0.35 && bestLag !== -1) {
            return sampleRate / bestLag;
        }
        return -1;
    };

    // ==========================================
    // --- LÓGICA DEL PIANO SINTETIZADOR ---
    // ==========================================
    let pianoCtx = null;
    const activeNotes = {};

    const playPianoNote = (freq, keyElement) => {
        if (!pianoCtx) pianoCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (pianoCtx.state === 'suspended') pianoCtx.resume();
        
        keyElement.classList.add('active');

        const osc1 = pianoCtx.createOscillator();
        const osc2 = pianoCtx.createOscillator();
        const gainNode = pianoCtx.createGain();

        osc1.type = 'triangle';
        osc2.type = 'sine';
        
        osc1.frequency.setValueAtTime(freq, pianoCtx.currentTime);
        osc2.frequency.setValueAtTime(freq + 0.5, pianoCtx.currentTime); 

        gainNode.gain.setValueAtTime(0, pianoCtx.currentTime);
        gainNode.gain.linearRampToValueAtTime(1, pianoCtx.currentTime + 0.015);
        gainNode.gain.exponentialRampToValueAtTime(0.001, pianoCtx.currentTime + 2.5);

        osc1.connect(gainNode);
        osc2.connect(gainNode);
        gainNode.connect(pianoCtx.destination);

        osc1.start();
        osc2.start();
        
        osc1.stop(pianoCtx.currentTime + 3);
        osc2.stop(pianoCtx.currentTime + 3);

        return { osc1, osc2, gainNode, keyElement };
    };

    const stopPianoNote = (noteObj) => {
        if (!noteObj || !pianoCtx) return;
        const { osc1, osc2, gainNode, keyElement } = noteObj;
        const now = pianoCtx.currentTime;
        
        gainNode.gain.cancelScheduledValues(now);
        gainNode.gain.setValueAtTime(gainNode.gain.value, now);
        gainNode.gain.exponentialRampToValueAtTime(0.001, now + 0.1);
        
        setTimeout(() => { try { osc1.stop(); osc2.stop(); } catch(e){} }, 150);
        keyElement.classList.remove('active');
    };

    // ==========================================
    // --- INICIALIZACIÓN DE EVENTOS ---
    // ==========================================
    document.addEventListener('DOMContentLoaded', () => {
        // --- Metrónomo ---
        const toggleBtn = document.getElementById('toggleMetronome');
        const bpmSlider = document.getElementById('bpmSlider');
        const bpmInput = document.getElementById('bpmInput');
        const tapTempoBtn = document.getElementById('tapTempoBtn');
        const timeSigSelect = document.getElementById('timeSignature');
        
        // --- Afinador ---
        const toggleTunerBtn = document.getElementById('toggleTuner');
        const noteDisplay = document.getElementById('noteDisplay');
        const centsDisplay = document.getElementById('centsDisplay');
        const needle = document.getElementById('needle');
        const a4Input = document.getElementById('a4Input');

        const updateBpm = (val) => {
            let newBpm = parseInt(val);
            if (isNaN(newBpm)) newBpm = 120;
            if (newBpm < 40) newBpm = 40;
            if (newBpm > 300) newBpm = 300; 
            
            bpm = newBpm;
            bpmInput.value = bpm;
            bpmSlider.value = bpm;
        };

        if (bpmSlider && bpmInput) {
            bpmSlider.addEventListener('input', (e) => updateBpm(e.target.value));
            bpmInput.addEventListener('change', (e) => updateBpm(e.target.value));
        }

        if (tapTempoBtn) {
            tapTempoBtn.addEventListener('click', () => {
                const now = performance.now();
                tapTimes.push(now);
                if (tapTimes.length > 4) tapTimes.shift(); 
                
                if (tapTimes.length > 1) {
                    let intervals = [];
                    for (let i = 1; i < tapTimes.length; i++) {
                        intervals.push(tapTimes[i] - tapTimes[i-1]);
                    }
                    const avgInterval = intervals.reduce((a, b) => a + b) / intervals.length;
                    const newBpm = Math.round(60000 / avgInterval);
                    updateBpm(newBpm);
                }
            });
        }

        if (timeSigSelect) timeSigSelect.addEventListener('change', () => currentBeat = 0);

        if (toggleBtn) {
            toggleBtn.addEventListener('click', () => {
                if (!metronomeCtx) metronomeCtx = new (window.AudioContext || window.webkitAudioContext)();
                if (metronomeCtx.state === 'suspended') metronomeCtx.resume();

                playing = !playing;

                if (playing) {
                    currentBeat = 0; 
                    nextTickTime = metronomeCtx.currentTime + 0.05;
                    scheduler();
                    toggleBtn.innerText = 'DETENER';
                    toggleBtn.classList.add('active-red');
                } else {
                    if (timerId) cancelAnimationFrame(timerId);
                    toggleBtn.innerText = 'INICIAR';
                    toggleBtn.classList.remove('active-red');
                }
            });
        }

        // --- Eventos Afinador ---
        let tunerActive = false;
        let tunerTimerId = null;
        let mediaStream = null;
        let analyserNode = null;
        let sourceNode = null;
        let baseA4 = 440;

        if (a4Input) {
            a4Input.addEventListener('change', (e) => {
                let val = parseFloat(e.target.value);
                if (val < 410) val = 410;
                if (val > 460) val = 460;
                baseA4 = val || 440;
                e.target.value = baseA4;
            });
        }

        const resetTunerUI = () => {
            noteDisplay.innerText = "--";
            noteDisplay.style.color = '#555';
            centsDisplay.innerText = "0 cents";
            needle.style.transform = `translateX(-50%)`;
            needle.style.backgroundColor = '#555';
        };

        if (toggleTunerBtn) {
            toggleTunerBtn.addEventListener('click', async () => {
                if (!tunerCtx) tunerCtx = new (window.AudioContext || window.webkitAudioContext)();
                if (tunerCtx.state === 'suspended') await tunerCtx.resume();

                if (tunerActive) {
                    tunerActive = false;
                    if (tunerTimerId) cancelAnimationFrame(tunerTimerId);
                    if (mediaStream) { mediaStream.getTracks().forEach(track => track.stop()); mediaStream = null; }
                    if (sourceNode) { sourceNode.disconnect(); sourceNode = null; }
                    if (analyserNode) { analyserNode.disconnect(); analyserNode = null; }
                    resetTunerUI();
                    toggleTunerBtn.innerText = 'ACTIVAR MICRÓFONO';
                    toggleTunerBtn.classList.remove('active-red');
                } else {
                    try {
                        mediaStream = await navigator.mediaDevices.getUserMedia({ audio: true });
                        sourceNode = tunerCtx.createMediaStreamSource(mediaStream);
                        analyserNode = tunerCtx.createAnalyser();
                        analyserNode.fftSize = 4096;
                        sourceNode.connect(analyserNode);

                        const buffer = new Float32Array(analyserNode.fftSize);
                        const noteNames = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
                        const dialWidth = document.querySelector('.dial-container').clientWidth;
                        
                        let smoothedCents = 0;
                        let lastMidiNote = -1;
                        tunerActive = true;
                        
                        toggleTunerBtn.innerText = 'DETENER MICRÓFONO';
                        toggleTunerBtn.classList.add('active-red');

                        const update = () => {
                            if (!tunerActive) return;

                            analyserNode.getFloatTimeDomainData(buffer);
                            const freq = autoCorrelate(buffer, tunerCtx.sampleRate);

                            if (freq !== -1) {
                                const midiNote = Math.round(12 * Math.log2(freq / baseA4) + 69);
                                const noteName = noteNames[midiNote % 12];
                                const octave = Math.floor(midiNote / 12) - 1; 
                                
                                const idealFreq = baseA4 * Math.pow(2, (midiNote - 69) / 12);
                                const currentCents = Math.round(1200 * Math.log2(freq / idealFreq));

                                if (midiNote !== lastMidiNote) {
                                    smoothedCents = currentCents;
                                    lastMidiNote = midiNote;
                                } else {
                                    smoothedCents = (smoothedCents * 0.8) + (currentCents * 0.2);
                                }

                                const displayCents = Math.round(smoothedCents);
                                noteDisplay.innerText = `${noteName}${octave}`; 
                                centsDisplay.innerText = `${displayCents > 0 ? '+' : ''}${displayCents} cents`;

                                const maxOffset = (dialWidth / 2) - 10; 
                                let ratio = smoothedCents / 50; 
                                if (ratio > 1) ratio = 1;
                                if (ratio < -1) ratio = -1;
                                
                                needle.style.transform = `translateX(calc(-50% + ${ratio * maxOffset}px))`;

                                if (Math.abs(smoothedCents) <= 5) {
                                    noteDisplay.style.color = '#00ff88'; 
                                    needle.style.backgroundColor = '#00ff88';
                                } else {
                                    noteDisplay.style.color = '#00e5ff'; 
                                    needle.style.backgroundColor = '#00e5ff';
                                }
                            } else {
                                smoothedCents = smoothedCents * 0.9;
                                resetTunerUI();
                                lastMidiNote = -1;
                            }
                            tunerTimerId = requestAnimationFrame(update);
                        };

                        update();
                    } catch (err) {
                        console.error('Error de micrófono:', err);
                        alert('No se pudo acceder al micrófono.');
                        tunerActive = false;
                    }
                }
            });
        }

        // --- Eventos del Piano Teclado/Mouse ---
        const keysElements = document.querySelectorAll('.piano-key');
        const getElByKey = (key) => document.querySelector(`.piano-key[data-key="${key}"]`);

        document.addEventListener('keydown', (e) => {
            if(e.repeat) return; 
            const key = e.key.toLowerCase();
            const el = getElByKey(key);
            if (el && !activeNotes[key]) {
                const freq = parseFloat(el.getAttribute('data-freq'));
                activeNotes[key] = playPianoNote(freq, el);
            }
        });

        document.addEventListener('keyup', (e) => {
            const key = e.key.toLowerCase();
            if (activeNotes[key]) {
                stopPianoNote(activeNotes[key]);
                delete activeNotes[key];
            }
        });

        keysElements.forEach(keyEl => {
            const pressKey = () => {
                const key = keyEl.getAttribute('data-key');
                if (!activeNotes[key]) {
                    const freq = parseFloat(keyEl.getAttribute('data-freq'));
                    activeNotes[key] = playPianoNote(freq, keyEl);
                }
            };
            const releaseKey = () => {
                const key = keyEl.getAttribute('data-key');
                if (activeNotes[key]) {
                    stopPianoNote(activeNotes[key]);
                    delete activeNotes[key];
                }
            };

            keyEl.addEventListener('mousedown', pressKey);
            keyEl.addEventListener('touchstart', (e) => { e.preventDefault(); pressKey(); });
            
            keyEl.addEventListener('mouseup', releaseKey);
            keyEl.addEventListener('mouseleave', releaseKey);
            keyEl.addEventListener('touchend', (e) => { e.preventDefault(); releaseKey(); });
        });
    });
</script>