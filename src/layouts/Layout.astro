---
// src/layouts/Layout.astro
import AmbientHUD from '../components/AmbientHUD.astro';
const { title = "Portafolio JavierF", lang = "es", description = "", pathEs = "", pathEn = "" } = Astro.props;
const isEn = lang === "en";
const base = import.meta.env.BASE_URL;

// Rutas adaptadas según el idioma
const homePath = isEn ? `${base}` : `${base}es/`;

const musicaPath = isEn ? `${base}music` : `${base}es/musica`;
const ingenieriaPath = isEn ? `${base}engineering` : `${base}es/ingenieria`;
const saxofonistaPath = isEn ? `${base}saxophonist` : `${base}es/saxofonista`;
const experienciaPath = isEn ? `${base}experience` : `${base}es/experiencia`;
const musicToolsPath = isEn ? `${base}music-tools` : `${base}es/music-tools`;
const audioToolsPath = isEn ? `${base}audiotools` : `${base}es/audiotools`;

const esTarget = pathEs ? `${base}es/${pathEs}` : `${base}es/`;
const enTarget = pathEn ? `${base}${pathEn}` : `${base}`;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
const hreflangEs = Astro.site && pathEs ? new URL(pathEs, Astro.site) : null;
const hreflangEn = Astro.site && pathEn ? new URL(pathEn, Astro.site) : null;
const ogLocale = isEn ? "en_US" : "es_MX";
---

<!DOCTYPE HTML>
<html lang={lang}>
    <head>
        <title>{title}</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
        {description && <meta name="description" content={description} />}
        {canonicalURL && <link rel="canonical" href={canonicalURL} />}
        {hreflangEs && <link rel="alternate" hreflang="es-MX" href={hreflangEs} />}
        {hreflangEn && <link rel="alternate" hreflang="en" href={hreflangEn} />}
        {hreflangEs && <link rel="alternate" hreflang="x-default" href={hreflangEs} />}
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Javier Flores — Portafolio" />
        <meta property="og:title" content={title} />
        {description && <meta property="og:description" content={description} />}
        <meta property="og:locale" content={ogLocale} />
        {canonicalURL && <meta property="og:url" content={canonicalURL} />}
        <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
        <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
        <link rel="shortcut icon" href={`${base}favicon.ico`} />
        <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
        
        <!-- Cabeceras de Seguridad Inyectadas -->
        <meta http-equiv="X-Frame-Options" content="DENY" />
        <meta http-equiv="X-Content-Type-Options" content="nosniff" />
        <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
        <meta http-equiv="Content-Security-Policy" content="default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https://formsubmit.co https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:;" />

        <link rel="stylesheet" href={`${base}assets/css/main.css`} />
        <noscript><link rel="stylesheet" href={`${base}assets/css/noscript.css`} /></noscript>
        
        {import.meta.env.PROD && (
            <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "YOUR_CLOUDFLARE_ANALYTICS_TOKEN"}'></script>
        )}
    </head>
    <body class="is-preload">

        <!-- Wrapper -->
            <div id="wrapper">

                <!-- Header -->
                    <header id="header" class="alt utility-header">
                        <a href={homePath} class="logo" aria-label="Javier Flores Audio Home">
                            <strong>Javier Flores Audio</strong> 
                            <span>{isEn ? "Music Production Engineer" : "Ingeniero en Producción Musical"}</span>
                        </a>
                        <nav aria-label={isEn ? "Main Navigation" : "Navegación Principal"}>
                            <div style="display: inline-flex; align-items: center; margin-right: 1rem; font-size: 0.85rem; font-weight: 600; letter-spacing: 0.1em;">
                                <a href={esTarget} aria-label="Cambiar idioma a Español" style={`color: ${!isEn ? '#ffffff' : '#a1a1aa'}; text-decoration: none; padding: 0.2rem 0.4rem; transition: color 0.2s;`}>ESP</a>
                                <span style="color: #a1a1aa; margin: 0 0.2rem;" aria-hidden="true">/</span>
                                <a href={enTarget} aria-label="Switch language to English" style={`color: ${isEn ? '#ffffff' : '#a1a1aa'}; text-decoration: none; padding: 0.2rem 0.4rem; transition: color 0.2s;`}>ENG</a>
                            </div>
                            <a href="#menu" aria-label={isEn ? "Open Menu" : "Abrir Menú"}>{isEn ? "Menu" : "Menú"}</a>
                        </nav>
                    </header>

                <!-- Menu -->
                    <nav id="menu" aria-label={isEn ? "Mobile Menu" : "Menú Móvil"}>
                        <ul class="links">
                            <li><a href={musicaPath}>{isEn ? "Music & Sound Design" : "Música y Diseño Sonoro"}</a></li>
                            <li><a href={ingenieriaPath}>{isEn ? "Engineering" : "Ingeniería"}</a></li>
                            <li><a href={experienciaPath}>{isEn ? "Experience" : "Experiencia"}</a></li>
                            <li><a href={saxofonistaPath}>{isEn ? "Saxophonist" : "Saxofonista"}</a></li>
                            <li><a href={musicToolsPath}>{isEn ? "Musician Tools" : "Herramientas Musicales"}</a></li>
                            <li><a href={audioToolsPath}>{isEn ? "Audio Engineering Tools" : "Herramientas de Audio"}</a></li>
                        </ul>
                        <ul class="actions stacked">
                            <li><a href={homePath} class="button primary fit">{isEn ? "HOME" : "INICIO"}</a></li>
                        </ul>
                    </nav>

                <!-- Contenido Principal con Landmark Semántico -->
                <main id="main-content">
                    <slot />
                </main>

                <!-- Contact -->
                    <section id="contact">
                        <div class="inner">
                            <section>
                                <div id="contact-wrapper">
                                    <form id="contact-form" action="https://formsubmit.co/ajax/musicproducerfj@gmail.com" method="POST">
                                        <input type="hidden" name="_subject" value="¡Nuevo mensaje de tu Portafolio web!">
                                        <input type="hidden" name="_captcha" value="false">

                                        <div class="fields">
                                            <div class="field half">
                                                <label for="name">{isEn ? "Name" : "Nombre"}</label>
                                                <input type="text" name="name" id="name" required />
                                            </div>
                                            <div class="field half">
                                                <label for="email">Email</label>
                                                <input type="email" name="email" id="email" required />
                                            </div>
                                            <div class="field">
                                                <label for="message">{isEn ? "Message" : "Mensaje"}</label>
                                                <textarea name="message" id="message" rows="6" required></textarea>
                                            </div>
                                        </div>
                                        <ul class="actions">
                                            <li><input type="submit" value={isEn ? "Send Message" : "Enviar mensaje"} class="primary" id="submit-btn" /></li>
                                            <li><input type="reset" value={isEn ? "Clear" : "Borrar"} /></li>
                                        </ul>
                                    </form>

                                    <div id="success-message" style="display: none; text-align: center; padding: 3rem 2rem; border: 2px solid #00e5ff; border-radius: 8px; background: rgba(0, 229, 255, 0.05); margin-top: 2rem;">
                                        <h3 style="color: #00e5ff; margin-bottom: 1rem; font-size: 1.5rem;">
                                            {isEn ? "Message sent successfully! 🚀" : "¡Mensaje enviado con éxito! 🚀"}
                                        </h3>
                                        <p style="color: #fff; font-size: 1.1rem; margin: 0;">
                                            {isEn ? "Thank you for reaching out. I'll get back to you as soon as possible." : "Gracias por contactarme. Revisaré tu mensaje y te responderé lo más pronto posible."}
                                        </p>
                                    </div>
                                </div>
                            </section>
                            <section class="split">
                                <section>
                                    <div class="contact-method">
                                        <span class="icon alt fa-envelope"></span>
                                        <h3>Email</h3>
                                        <a href="mailto:musicproducerfj@gmail.com">musicproducerfj@gmail.com</a>
                                    </div>
                                </section>
                                <section>
                                    <div class="contact-method">
                                        <span class="icon alt fa-phone"></span>
                                        <h3>{isEn ? "Phone" : "Teléfono"}</h3>
                                        <span>(244) 106 95 27</span><br />
                                    </div>
                                </section>
                                <section>
                                    <div class="contact-method">
                                        <span class="icon alt fa-home"></span>
                                        <h3>{isEn ? "Address" : "Dirección"}</h3>
                                        <span>Atlixco, Puebla<br />
                                        México</span>
                                    </div>
                                </section>
                            </section>
                        </div>
                    </section>

                <!-- Footer -->
                    <footer id="footer">
                        <div class="inner">
                            <ul class="icons">
                                <li><a href="https://vimeo.com/user98279329" class="icon alt fa-vimeo" target="_blank" rel="noopener" aria-label="Vimeo Profile"><span class="label">Vimeo</span></a></li>
                                <li><a href="https://soundcloud.com/javier-flores-flores-96937841" class="icon alt fa-soundcloud" target="_blank" rel="noopener" aria-label="SoundCloud Profile"><span class="label">SoundCloud</span></a></li>
                                <li><a href="https://www.linkedin.com/in/javier-flores-5556b511b/" class="icon alt fa-linkedin" target="_blank" rel="noopener" aria-label="LinkedIn Profile"><span class="label">LinkedIn</span></a></li>
                                <li><a href="https://web.facebook.com/javier.sax.flores" class="icon alt fa-facebook" target="_blank" rel="noopener" aria-label="Facebook Profile"><span class="label">Facebook</span></a></li>
                                <li><a href="https://www.instagram.com/javier.flsfls/" class="icon alt fa-instagram" target="_blank" rel="noopener" aria-label="Instagram Profile"><span class="label">Instagram</span></a></li>
                            </ul>
                            <ul class="copyright">
                                <li>&copy; {isEn ? "Page programming:" : "Programación de la página:"} Javier Flores</li><li>Design: <a href="https://html5up.net" aria-label="HTML5 UP Design">HTML5 UP</a></li>
                            </ul>
                        </div>
                    </footer>
            </div>

        <!-- Scripts base -->
            <script is:inline src={`${base}assets/js/jquery.min.js`}></script>
            <script is:inline src={`${base}assets/js/jquery.scrolly.min.js`}></script>
            <script is:inline src={`${base}assets/js/jquery.scrollex.min.js`}></script>
            <script is:inline src={`${base}assets/js/browser.min.js`}></script>
            <script is:inline src={`${base}assets/js/breakpoints.min.js`}></script>
            <script is:inline src={`${base}assets/js/util.js`}></script>
            <script is:inline src={`${base}assets/js/main.js`}></script>
            
            <!-- Script de Envío AJAX para FormSubmit -->
            <script is:inline>
                document.addEventListener('DOMContentLoaded', function() {
                    const form = document.getElementById('contact-form');
                    const successMessage = document.getElementById('success-message');
                    const submitBtn = document.getElementById('submit-btn');

                    if (form) {
                        form.addEventListener('submit', function(e) {
                            e.preventDefault();

                            const originalText = submitBtn.value;
                            submitBtn.value = submitBtn.value === 'Enviar mensaje' ? 'Enviando...' : 'Sending...';
                            submitBtn.disabled = true;

                            const formData = new FormData(form);

                            fetch(form.action, {
                                method: 'POST',
                                body: formData,
                                headers: { 'Accept': 'application/json' }
                            })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success === "true" || data.success === true) {
                                    form.style.display = 'none';
                                    successMessage.style.display = 'block';
                                } else {
                                    alert(submitBtn.value === 'Sending...' ? 'Error sending message. Please try again.' : 'Hubo un error al enviar el mensaje. Por favor intenta de nuevo.');
                                    submitBtn.value = originalText;
                                    submitBtn.disabled = false;
                                }
                            })
                            .catch(error => {
                                console.error('Error:', error);
                                alert(submitBtn.value === 'Sending...' ? 'Network error. Please try again.' : 'Error de red. Por favor intenta de nuevo.');
                                submitBtn.value = originalText;
                                submitBtn.disabled = false;
                            });
                        });
                    }
                });
            </script>

    <style>
        .utility-header {
            background-color: rgba(15, 19, 31, 0.5) ;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-top: 4px solid rgba(0, 229, 255, 0.713);
            border-bottom: none;
            display: flex ;
            justify-content: space-between ;
            align-items: center ;
        }
        .utility-header nav {
            display: flex;
            align-items: center;
        }
    </style>
    <AmbientHUD lang={lang} />

    <!-- Cookie Banner -->
    <div id="cookie-banner" style="display: none; position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); width: calc(100% - 48px); max-width: 480px; z-index: 9999; background: rgba(15, 19, 31, 0.85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(0, 229, 255, 0.3); border-radius: 12px; padding: 1.25rem; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 20px rgba(0, 229, 255, 0.15); color: #ffffff; font-family: inherit; font-size: 0.9rem; text-align: center; flex-direction: column; align-items: center; gap: 1rem;">
        <div style="width: 100%;">
            <p style="margin: 0; line-height: 1.4; color: #e2e8f0; font-size: 0.85rem; text-align: center;">
                {isEn 
                    ? "This site uses cookies to enhance your experience and analyze traffic. You can accept or decline their use."
                    : "Este sitio utiliza cookies para mejorar tu experiencia y analizar el tráfico. Puedes aceptar o rechazar su uso."}
            </p>
        </div>
        <div style="display: flex; gap: 0.75rem; justify-content: center; width: 100%;">
            <button id="cookie-decline" style="background: transparent; border: 1px solid rgba(255, 255, 255, 0.2); color: #a1a1aa; padding: 0.4rem 1rem; border-radius: 6px; cursor: pointer; font-size: 0.85rem; font-weight: 600; transition: all 0.2s;">
                {isEn ? "Decline" : "Rechazar"}
            </button>
            <button id="cookie-accept" style="background: #00e5ff; border: none; color: #0f131f; padding: 0.4rem 1.25rem; border-radius: 6px; cursor: pointer; font-size: 0.85rem; font-weight: 700; transition: all 0.2s; box-shadow: 0 0 10px rgba(0, 229, 255, 0.4);">
                {isEn ? "Accept" : "Aceptar"}
            </button>
        </div>
    </div>

    <!-- Script Integrado de Cookies y GA4 -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const GA_MEASUREMENT_ID = 'G-F7M06SDLDR'; 
            
            const consent = localStorage.getItem('cookie_consent');
            const banner = document.getElementById('cookie-banner');

            const loadGoogleAnalytics = () => {
                if (window.gaLoaded) return;
                
                const script = document.createElement('script');
                script.async = true;
                script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`;
                document.head.appendChild(script);

                window.dataLayer = window.dataLayer || [];
                function gtag(){ window.dataLayer.push(arguments); }
                gtag('js', new Date());
                gtag('config', GA_MEASUREMENT_ID);
                
                window.gaLoaded = true;
            };

            if (consent === 'accepted') {
                loadGoogleAnalytics();
            } else if (!consent && banner) {
                banner.style.display = 'flex';
            }

            document.getElementById('cookie-accept')?.addEventListener('click', () => {
                localStorage.setItem('cookie_consent', 'accepted');
                if (banner) banner.style.display = 'none';
                loadGoogleAnalytics();
            });

            document.getElementById('cookie-decline')?.addEventListener('click', () => {
                localStorage.setItem('cookie_consent', 'declined');
                if (banner) banner.style.display = 'none';
            });
        });
    </script>
    </body>
</html>